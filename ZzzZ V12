-- Dynamic Hitbox Loop
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            
            local head = char:FindFirstChild("Head")
            if head then
                if headHitboxEnabled then
                    head.Size = Vector3.new(10, 10, 10)
                    head.Transparency = 0.6
                    head.Color = Color3.fromRGB(0, 170, 255)
                    head.Material = Enum.Material.Neon
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(2, 1, 1)
                    head.Transparency = 0
                    head.Material = Enum.Material.Plastic
                end
            end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if bodyHitboxEnabled then
                    hrp.Size = Vector3.new(12, 12, 12)
                    hrp.Transparency = 0.7
                    hrp.Color = Color3.fromRGB(0, 255, 120)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end
end)

-- 🥊 SKILL 1: หมัดหมุนเร็วมาก + โดนคนปลิวออกนอกแมพ
local function runWindmillPunchSkill()
    if isSpinningFists then return end
    local char = LocalPlayer.Character
    if not char then return end

    local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
    if not leftArm or not rightArm then return end

    isSpinningFists = true

    -- สร้างเอฟเฟกต์หมุนพายุรอบแขน
    local touchConnections = {}

    local function setupArmTouch(arm)
        local conn = arm.Touched:Connect(function(hit)
            local hitChar = hit.Parent
            if hitChar and hitChar:FindFirstChildOfClass("Humanoid") and hitChar ~= char then
                sendToSpace(hitChar)
            end
        end)
        table.insert(touchConnections, conn)
    end

    setupArmTouch(leftArm)
    setupArmTouch(rightArm)

    -- แขนหมุนด้วยความเร็วสูง เป็นเวลา 3 วินาที
    local startTime = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        if elapsed >= 3 then
            conn:Disconnect()
            for _, c in ipairs(touchConnections) do c:Disconnect() end
            isSpinningFists = false
        else
            local angle = elapsed * 50 -- ความเร็วในการหมุนแขน
            leftArm.CFrame = leftArm.CFrame * CFrame.Angles(math.rad(angle), 0, 0)
            rightArm.CFrame = rightArm.CFrame * CFrame.Angles(-math.rad(angle), 0, 0)
        end
    end)
end

