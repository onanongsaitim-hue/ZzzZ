-- ORBIT RAINBOW BLOCKS & WHEEL EXTENSION LOGIC
---------------------------------------------------------
local function FindCarWheels(car)
    local wheels = {}
    for _, part in pairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if name:find("wheel") or name:find("tire") or name:find("rim") or name:find("ล้อ") then
                table.insert(wheels, part)
            end
        end
    end
    return wheels
end

local orbitAngle = 0
RunService.RenderStepped:Connect(function()
    orbitAngle = (orbitAngle + 0.03) % (math.pi * 2)

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChildOfClass("Humanoid")

        ---------------------------------------------------------
        -- 1. บล็อกไฟ LED สีรุ้ง 10 อัน หมุนวนรอบหลัง (World-Up Aligned)
        ---------------------------------------------------------
        local blocksFolder = workspace:FindFirstChild("ZzzZ_OrbitLEDBlocks_" .. LocalPlayer.Name)

        if State.BackLEDEnabled then
            if not blocksFolder then
                blocksFolder = Instance.new("Folder")
                blocksFolder.Name = "ZzzZ_OrbitLEDBlocks_" .. LocalPlayer.Name
                blocksFolder.Parent = workspace

                -- สร้างบล็อกอันเล็กๆ 10 อัน
                for i = 1, 10 do
                    local block = Instance.new("Part")
                    block.Name = "LEDBlock_" .. i
                    block.Size = Vector3.new(0.4, 0.4, 0.4) -- บล็อกอันเล็กพอดิบพอดี
                    block.Material = Enum.Material.Neon
                    block.Anchored = true
                    block.CanCollide = false
                    block.CanTouch = false
                    block.CanQuery = false
                    block.Parent = blocksFolder

                    local light = Instance.new("PointLight")
                    light.Name = "LEDLight"
                    light.Range = 6
                    light.Brightness = 3
                    light.Parent = block
                end
            end

            -- คำนวณตำแหน่งหมุนวนรอบหลังแบบขนานพื้นโลก (ไม่ก้มตามตัวละคร)
            local centerPos = hrp.Position - (hrp.CFrame.LookVector * 1.5) + Vector3.new(0, 0.5, 0)
            local radius = 2.2 -- ระยะห่างวงหมุน

            for i = 1, 10 do
                local block = blocksFolder:FindFirstChild("LEDBlock_" .. i)
                if block then
                    local currentAngle = orbitAngle + ((i / 10) * math.pi * 2)
                    local offsetX = math.cos(currentAngle) * radius
                    local offsetZ = math.sin(currentAngle) * radius
                    
                    -- กำหนด CFrame ให้ลอยอิสระไม่เอียงตามการก้มตัว
                    block.CFrame = CFrame.new(centerPos + Vector3.new(offsetX, 0, offsetZ))
                    
                    -- สีรุ้งไล่ระดับทั้ง 10 บล็อก
                    local hue = ((i / 10) + (orbitAngle / (math.pi * 2))) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.9, 1)
                    block.Color = rainbowColor
                    if block:FindFirstChild("LEDLight") then
                        block.LEDLight.Color = rainbowColor
                    end
                end
            end
        else
            if blocksFolder then blocksFolder:Destroy() end
        end

        ---------------------------------------------------------
        -- 2. ระบบควบคุมรถ & ยืดล้อหลังถ่างกว้างออก
        ---------------------------------------------------------
        if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
            local seat = hum.SeatPart
            local car = seat:FindFirstAncestorOfClass("Model") or seat.Parent

            -- Speed Boost
            if State.VehicleBoostEnabled then
                seat.MaxSpeed = State.VehicleSpeed
                seat.Torque = State.VehicleSpeed * 10
                if seat.Throttle ~= 0 then
                    seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (seat.Throttle * State.VehicleSpeed)
                end
            end

            -- ความสูงรถ (โหลดเตี้ย)
            if car then
                for _, spring in pairs(car:GetDescendants()) do
                    if spring:IsA("SpringConstraint") then
                        spring.FreeLength = math.max(0.1, State.VehicleSuspension + State.VehicleHeight)
                    end
                end

                -- ยืดล้อหลังถ่างกว้างออกด้านข้าง
                local wheels = FindCarWheels(car)
                for _, wheel in ipairs(wheels) do
                    local name = wheel.Name:lower()
                    if name:find("rear") or name:find("back") or name:find("หลัง") or name:find("r") then
                        local isRight = (wheel.Position - seat.Position):Dot(seat.CFrame.RightVector) > 0
                        local extVal = isRight and State.RearWheelExtension or -State.RearWheelExtension

                        -- ขยายระยะข้อต่อล้อ (Joints/Welds)
                        for _, joint in pairs(wheel:GetJoints()) do
                            if joint:IsA("Weld") or joint:IsA("Motor6D") then
                                joint.C0 = CFrame.new(extVal, 0, 0)
                            elseif joint:IsA("CylindricalConstraint") or joint:IsA("SpringConstraint") then
                                if joint.Attachment0 then
                                    joint.Attachment0.CFrame = CFrame.new(extVal, 0, 0)
                                end
                            end
                        end
                    end
                end
            end
        end

    end
end)

