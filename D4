-- 1. Hitbox Extender Loop
RunService.RenderStepped:Connect(function()
    if State.HitboxEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if head then
                    head.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
                    head.Transparency = 0.5
                    head.BrickColor = BrickColor.new("Bright red")
                    head.Material = Enum.Material.Neon
                    head.CanCollide = false
                end
            end
        end
    end
end)

-- 2. Skill Lock Camera Loop
RunService.RenderStepped:Connect(function()
    if State.SkillLockEnabled then
        if not State.SkillLockTarget or not State.SkillLockTarget.Parent or not State.SkillLockTarget:FindFirstChild("HumanoidRootPart") then
            -- หาเป้าหมายที่ใกล้สุด
            local closest = nil
            local shortestDistance = math.huge
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closest = plr.Character
                    end
                end
            end
            State.SkillLockTarget = closest
        end
        
        if State.SkillLockTarget and State.SkillLockTarget:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, State.SkillLockTarget.HumanoidRootPart.Position)
        end
    end
end)

-- 3. Noclip Loop
RunService.Stepped:Connect(function()
    if State.Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- 4. Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if State.InfiniteJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- 5. Auto Attack
task.spawn(function()
    while true do
        task.wait(0.1)
        if State.AutoAttackEnabled and LocalPlayer.Character then
            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
        end
    end
end)

-- 6. Health Mod (Auto Regen & God Mode)
task.spawn(function()
    while true do
        task.wait(State.RegenInterval)
        if State.AutoRegenEnabled and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
                hum.Health = math.min(hum.Health + State.RegenAmount, hum.MaxHealth)
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if State.GodModeEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            hum.Health = hum.MaxHealth
        end
    end
end)

-- 7. Vehicle Boost Loop
RunService.RenderStepped:Connect(function()
    if State.VehicleBoostEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
            hum.SeatPart.MaxSpeed = State.VehicleSpeed
        end
    end
end)

