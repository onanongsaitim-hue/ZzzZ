-- ระบบลากหน้าต่าง (Draggable UI)
local dragging, dragInput, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

RunService.RenderStepped:Connect(function()
	if dragging and dragInput then
		local delta = dragInput.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- ตัวแปรควบคุมการบินของ F-16
local activeJet = nil
local currentSpeed = 30
local maxSpeed = 100
local moveDir = Vector3.new(0, 0, 0)
local turnAngle = 0
local altChange = 0

-- ตัวแปรรับค่าปุ่มกดค้าง
local isMovingForward, isMovingBackward = false, false
local isTurningLeft, isTurningRight = false, false
local isGoingUp, isGoingDown = false, false

-- ฟังก์ชันสร้างและควบคุม F-16
spawnButton.MouseButton1Click:Connect(function()
	if activeJet then activeJet:Destroy() end
	
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	
	local targetPos = character.HumanoidRootPart.Position
	local spawnPos = targetPos + Vector3.new(0, 200, 0)
	
	-- สร้างโมเดลเครื่องบิน F-16
	local jetModel = Instance.new("Model")
	jetModel.Name = "ControlledF16"
	jetModel.Parent = workspace
	
	local fuselage = Instance.new("Part")
	fuselage.Size = Vector3.new(3, 3, 16)
	fuselage.Position = spawnPos
	fuselage.CFrame = CFrame.new(spawnPos)
	fuselage.Color = Color3.fromRGB(100, 110, 120)
	fuselage.Material = Enum.Material.SmoothPlastic
	fuselage.Anchored = true
	fuselage.CanCollide = false
	fuselage.Parent = jetModel
	
	local wings = Instance.new("Part")
	wings.Size = Vector3.new(12, 0.4, 6)
	wings.CFrame = fuselage.CFrame
	wings.Color = Color3.fromRGB(90, 100, 110)
	wings.Material = Enum.Material.SmoothPlastic
	wings.Anchored = true
	wings.CanCollide = false
	wings.Parent = jetModel
	
	-- เอฟเฟกต์ลม/ไอพ่นใต้เครื่องบิน
	local windEffect = Instance.new("ParticleEmitter")
	windEffect.Name = "WindEffect"
	windEffect.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
	windEffect.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6)})
	windEffect.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
	windEffect.Lifetime = NumberRange.new(0.5, 1)
	windEffect.Rate = 120
	windEffect.Speed = NumberRange.new(5, 10)
	windEffect.Parent = fuselage
	
	activeJet = jetModel
	currentSpeed = 40
	
	local currentCF = fuselage.CFrame
	
	-- ลูปการควบคุมการเคลื่อนไหวของเครื่องบินแบบเรียลไทม์
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		if not fuselage or not fuselage.Parent then
			if connection then connection:Disconnect() end
			return
		end
		
		-- คำนวณการเลี้ยว (Yaw)
		local turnSpeed = 1.5 * dt
		if isTurningLeft then currentCF = currentCF * CFrame.Angles(0, turnSpeed, 0) end
		if isTurningRight then currentCF = currentCF * CFrame.Angles(0, -turnSpeed, 0) end
		
		-- คำนวณการขึ้น/ลง (Altitude)
		local altSpeed = 25 * dt
		local verticalOffset = 0
		if isGoingUp then verticalOffset = altSpeed end
		if isGoingDown then verticalOffset = -altSpeed end
		
		-- คำนวณการเดินหน้า/ถอยหลัง
		local moveSpeed = currentSpeed * dt
		local forwardVal = 0
		if isMovingForward then forwardVal = -moveSpeed end
		if isMovingBackward then forwardVal = moveSpeed end
		
		-- ขยับตำแหน่ง CFrame
		currentCF = currentCF + (currentCF.LookVector * forwardVal) + Vector3.new(0, verticalOffset, 0)
		fuselage.CFrame = currentCF
		wings.CFrame = currentCF
		
		speedLabel.Text = "ความเร็ว: " .. math.floor(currentSpeed) .. " | สูงสุด: " .. maxSpeed
	end)
end)

-- ผูกเหตุการณ์กดปุ่มเพิ่ม/ลดความเร็ว
speedUpBtn.MouseButton1Click:Connect(function()
	currentSpeed = math.min(currentSpeed + 10, maxSpeed)
end)

speedDownBtn.MouseButton1Click:Connect(function()
	currentSpeed = math.max(currentSpeed - 10, 0)
end)

-- ระบบกดค้างเพื่อบังคับทิศทาง
local function bindHoldButton(button, startAction, endAction)
	button.MouseButton1Down:Connect(startAction)
	button.MouseButton1Up:Connect(endAction)
	button.MouseLeave:Connect(endAction)
	button.TouchTap:Connect(function()
		startAction()
		task.delay(0.2, endAction)
	end)
end

bindHoldButton(forwardBtn, function() isMovingForward = true end, function() isMovingForward = false end)
bindHoldButton(backwardBtn, function() isMovingBackward = true end, function() isMovingBackward = false end)
bindHoldButton(leftBtn, function() isTurningLeft = true end, function() isTurningLeft = false end)
bindHoldButton(rightBtn, function() isTurningRight = true end, function() isTurningRight = false end)
bindHoldButton(upBtn, function() isGoingUp = true end, function() isGoingUp = false end)
bindHoldButton(downBtn, function() isGoingDown = true end, function() isGoingDown = false end)

