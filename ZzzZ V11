-- ⚡ CLOCK SKILL 1: เร่งเวลาวิ่งเร็ว 10 วินาที
-- ========================================================
local function runClockSkill1()
    if not clockEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    isPerformingSpecial = true

    -- เร่งเอฟเฟกต์หมุนเข็มเวลาเร็วปรี๊ด
    minuteHandAngle = minuteHandAngle + 1440

    -- ออร่าเร่งเวลาสีฟ้าวนรอบตัว
    local aura = Instance.new("SelectionBox")
    aura.Color3 = Color3.fromRGB(0, 230, 255)
    aura.Adornee = char
    aura.Parent = char

    local origSpeed = hum.WalkSpeed
    hum.WalkSpeed = origSpeed + 60 -- บูทความเร็วพุ่งทะยาน

    task.wait(10) -- วิ่งเร็ว 10 วินาที

    hum.WalkSpeed = origSpeed
    if aura then aura:Destroy() end

    isPerformingSpecial = false
end

-- ========================================================
-- ⏳ CLOCK SKILL 2: หักล้างเวลาชะลอช้าลง (Slow Motion Dome)
-- ========================================================
local function runClockSkill2()
    if not clockEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    if not torso then return end

    isPerformingSpecial = true

    -- โดมคลื่นเวลาสีฟ้าขยายครอบคลุม
    local dome = Instance.new("Part")
    dome.Shape = Enum.PartType.Ball
    dome.Size = Vector3.new(2, 2, 2)
    dome.Material = Enum.Material.ForceField
    dome.Color = Color3.fromRGB(0, 180, 255)
    dome.CFrame = torso.CFrame
    dome.Anchored = true
    dome.CanCollide = false
    dome.Parent = workspace

    TweenService:Create(dome, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = Vector3.new(60, 60, 60), Transparency = 0.4}):Play()

    -- ลดความเร็วศัตรูรอบข้าง
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
            local oHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
            local oHrP = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            if oHum and oHrP and (oHrP.Position - torso.Position).Magnitude <= 30 then
                oHum.WalkSpeed = 4
            end
        end
    end

    task.wait(4)

    TweenService:Create(dome, TweenInfo.new(0.5), {Size = Vector3.new(0, 0, 0), Transparency = 1}):Play()
    game:GetService("Debris"):AddItem(dome, 0.5)

    -- คืนความเร็วศัตรู
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
            local oHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
            if oHum then oHum.WalkSpeed = 16 end
        end
    end

    isPerformingSpecial = false
end

-- ========================================================
-- 🏹 CLOCK SKILL 3: ยิงศรเวลากระเด็นออกนอกโลก
-- ========================================================
local function runClockSkill3()
    if not clockEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    if not torso then return end

    isPerformingSpecial = true

    local forwardCF = torso.CFrame

    -- สร้างคันธนูศักดิ์สิทธิ์สีขาวทอง
    local bow = Instance.new("Part")
    bow.Size = Vector3.new(1, 7, 1)
    bow.Material = Enum.Material.Neon
    bow.Color = Color3.fromRGB(255, 255, 245)
    bow.CFrame = forwardCF * CFrame.new(0, 1, -4) * CFrame.Angles(0, 0, math.rad(45))
    bow.Anchored = true
    bow.CanCollide = false
    bow.Parent = workspace

    -- สร้างลูกศรเวลา
    local arrow = Instance.new("Part")
    arrow.Size = Vector3.new(0.4, 0.4, 8)
    arrow.Material = Enum.Material.Neon
    arrow.Color = Color3.fromRGB(0, 220, 255)
    arrow.CFrame = bow.CFrame * CFrame.new(0, 0, -1)
    arrow.Anchored = true
    arrow.CanCollide = false
    arrow.Parent = workspace

    task.wait(0.4) -- จังหวะง้างสายธนู

    -- ยิงศรพุ่งทะยานออกไปข้างหน้า
    local endCF = arrow.CFrame * CFrame.new(0, 0, -180)

    local touchConn = arrow.Touched:Connect(function(hit)
        local hitModel = hit.Parent
        if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
            sendToSpace(hitModel)
        end
    end)

    TweenService:Create(arrow, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {CFrame = endCF}):Play()

    task.wait(0.35)

    if touchConn then touchConn:Disconnect() end
    bow:Destroy()
    arrow:Destroy()

    isPerformingSpecial = false
end

