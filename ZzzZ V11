local romanNumerals = {"I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"}

-- ⏱️ สร้างโมเดลวงนาฬิกาเลขโรมันโบราณเรืองแสงสีฟ้า
local function createAncientClockModel()
    local clock = Instance.new("Model")
    clock.Name = "ChronosAncientClock"

    local centerPart = Instance.new("Part")
    centerPart.Name = "CenterPart"
    centerPart.Size = Vector3.new(0.8, 0.8, 0.3)
    centerPart.Material = Enum.Material.Neon
    centerPart.Color = Color3.fromRGB(0, 190, 255)
    centerPart.CanCollide = false
    centerPart.Anchored = true
    centerPart.Parent = clock

    -- สร้าง 12 ตัวเลขโรมันลอยเป็นวงกลมเรืองแสง
    local radius = 4.5
    for i = 1, 12 do
        local angle = math.rad((i * 30) - 90)
        local x = math.cos(angle) * radius
        local y = -math.sin(angle) * radius

        local numPart = Instance.new("Part")
        numPart.Name = "Roman_" .. romanNumerals[i]
        numPart.Size = Vector3.new(0.8, 0.8, 0.1)
        numPart.Transparency = 1
        numPart.CanCollide = false
        numPart.Anchored = true
        numPart.Parent = clock

        local bbGui = Instance.new("BillboardGui")
        bbGui.Size = UDim2.new(0, 40, 0, 40)
        bbGui.AlwaysOnTop = true
        bbGui.Parent = numPart

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = romanNumerals[i]
        textLabel.TextColor3 = Color3.fromRGB(120, 220, 255)
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.Bodoni
        textLabel.Parent = bbGui

        numPart.Position = centerPart.Position + Vector3.new(x, y, 0)
    end

    -- เข็มสั้นลูกศรศักดิ์สิทธิ์
    local hourHand = Instance.new("Part")
    hourHand.Name = "HourHand"
    hourHand.Size = Vector3.new(0.3, 2.5, 0.2)
    hourHand.Material = Enum.Material.Neon
    hourHand.Color = Color3.fromRGB(245, 245, 255)
    hourHand.CanCollide = false
    hourHand.Anchored = true
    hourHand.Parent = clock

    -- เข็มยาวลูกศรศักดิ์สิทธิ์
    local minuteHand = Instance.new("Part")
    minuteHand.Name = "MinuteHand"
    minuteHand.Size = Vector3.new(0.25, 3.8, 0.2)
    minuteHand.Material = Enum.Material.Neon
    minuteHand.Color = Color3.fromRGB(255, 255, 255)
    minuteHand.CanCollide = false
    minuteHand.Anchored = true
    minuteHand.Parent = clock

    clock.PrimaryPart = centerPart
    return clock
end

