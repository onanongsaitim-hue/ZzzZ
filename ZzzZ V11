local function createDragonSteelSword(index)
    local sword = Instance.new("Model")
    sword.Name = "DragonSteelSword_" .. tostring(index)

    local blade = Instance.new("Part")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.5, 9.5, 1.6)
    blade.Material = Enum.Material.Metal
    blade.Color = Color3.fromRGB(110, 115, 120)
    blade.CanCollide = false
    blade.Anchored = true
    blade.Parent = sword

    local edge = Instance.new("Part")
    edge.Name = "Edge"
    edge.Size = Vector3.new(0.1, 9.2, 0.4)
    edge.Material = Enum.Material.SmoothPlastic
    edge.Color = Color3.fromRGB(220, 220, 230)
    edge.CanCollide = false
    edge.Anchored = true
    edge.Parent = sword

    local eWeld = Instance.new("WeldConstraint")
    eWeld.Part0 = blade
    eWeld.Part1 = edge
    edge.CFrame = blade.CFrame * CFrame.new(0, 0, -0.8)
    eWeld.Parent = blade

    sword.PrimaryPart = blade
    return sword
end

local function spawnDragonSwords()
    for _, sw in pairs(dragonSwordsTable) do if sw then sw:Destroy() end end
    dragonSwordsTable = {}

    if swordRingEnabled then
        local folder = workspace:FindFirstChild("ZzzZ_Swords_World") or Instance.new("Folder", workspace)
        folder.Name = "ZzzZ_Swords_World"

        for i = 1, 10 do
            local sw = createDragonSteelSword(i)
            sw.Parent = folder
            table.insert(dragonSwordsTable, sw)
        end
        currentForm = "Dragon"
    else
        if currentForm == "Dragon" then currentForm = "None" end
    end
    updateSkillButtons()
end

