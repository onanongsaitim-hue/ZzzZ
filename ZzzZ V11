-- --------------------------------------------------------
-- 🔄 MAIN RENDER LOOP (อัปเดตตำแหน่งนาฬิกาตั้งตรงอิสระ + เดินเข็มติ๊กๆ)
-- --------------------------------------------------------
RunService.RenderStepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    if not char then return end

    -- ⏱️ อัปเดตร่างนาฬิกาควบคุมเวลา
    if clockEnabled and clockModel and clockModel.PrimaryPart then
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then
            -- ตำแหน่งลอยด้านหลังตัวละคร (รักษาระดับแนวตั้ง ไม่ก้มตามตัวละคร)
            local backPos = torso.Position + Vector3.new(0, 3.5, 4.5)
            local targetCFrame = CFrame.new(backPos) -- ตั้งตรงอิสระไม่ก้มตามมุมกล้อง/หัวก้ม
            clockModel.PrimaryPart.CFrame = clockModel.PrimaryPart.CFrame:Lerp(targetCFrame, 0.2)

            -- ระบบขยับเข็มนาฬิกา: เข็มยาวขยับก่อน 3-4 ครั้ง -> เข็มสั้นขยับตาม
            tickCount = tickCount + (deltaTime * 4)
            if tickCount >= 1 then
                tickCount = 0
                minuteHandAngle = minuteHandAngle + 30 -- เข็มยาวขยับเดินติ๊ก
                if (minuteHandAngle / 30) % 4 == 0 then
                    hourHandAngle = hourHandAngle + 15 -- เข็มสั้นขยับตามเมื่อเข็มยาวขยับครบ 4 ครั้ง
                end
            end

            -- อัปเดตตำแหน่งและองศาเข็ม
            local centerCF = clockModel.PrimaryPart.CFrame
            local mHand = clockModel:FindFirstChild("MinuteHand")
            local hHand = clockModel:FindFirstChild("HourHand")

            if mHand then
                mHand.CFrame = centerCF * CFrame.Angles(0, 0, math.rad(-minuteHandAngle)) * CFrame.new(0, 1.8, 0)
            end
            if hHand then
                hHand.CFrame = centerCF * CFrame.Angles(0, 0, math.rad(-hourHandAngle)) * CFrame.new(0, 1.2, 0)
            end
        end
    end
end)
