local function createDroneModel(cframe)
	local model = Instance.new("Model")
	model.Name = "SquareDrone"

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.new(2, 0.8, 2)
	core.Color = Color3.fromRGB(30, 30, 35)
	core.Material = Enum.Material.Neon
	core.CFrame = cframe
	core.CanCollide = true
	core.Parent = model
	model.PrimaryPart = core

	-- ไฟสถานะสีเขียวแฮ็กเกอร์
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(50, 255, 100)
	light.Brightness = 3
	light.Range = 10
	light.Parent = core

	model.Parent = workspace
	return model
end

-- ==========================================
-- 6. ฟังก์ชันควบคุมการบินโดรน
-- ==========================================
local function startDroneControl()
	if not deployedDrone or not deployedDrone.PrimaryPart then return end
	
	playStaticFlashback(function()
		isControlling = true
		hackerGui.Enabled = true
		camera.CameraType = Enum.CameraType.Scriptable
	end)

	local dronePart = deployedDrone.PrimaryPart
	local currentPos = dronePart.Position
	local currentYaw = 0
	local speed = 28
	local turnSpeed = 2.2

	if droneConnection then droneConnection:Disconnect() end

	droneConnection = RunService.RenderStepped:Connect(function(dt)
		if not deployedDrone or not deployedDrone.Parent or not isControlling then return end

		-- คำนวณการเลี้ยวซ้าย/ขวา
		if turnLeft then currentYaw = currentYaw + (turnSpeed * dt) end
		if turnRight then currentYaw = currentYaw - (turnSpeed * dt) end

		local rotCF = CFrame.Angles(0, currentYaw, 0)
		local forwardVec = rotCF.LookVector

		-- คำนวณการเคลื่อนที่ (เดินหน้า/ถอยหลัง/ขึ้น/ลง)
		local moveVector = Vector3.new(0, 0, 0)
		if moveForward then moveVector = moveVector + forwardVec end
		if moveBackward then moveVector = moveVector - forwardVec end
		
		local upDownInput = 0
		if moveUp then upDownInput = 1 end
		if moveDown then upDownInput = -1 end

		currentPos = currentPos + (moveVector * speed * dt) + Vector3.new(0, upDownInput * speed * dt, 0)
		
		local targetCF = CFrame.new(currentPos) * rotCF
		deployedDrone:SetPrimaryPartCFrame(targetCF)

		-- มุมมองบุคคลที่หนึ่งติดที่ตัวโดรนเต็มจอ
		camera.CFrame = targetCF * CFrame.new(0, 0.4, 0)

		-- เอฟเฟกต์ภาพซ่าหน้าจอแบบสุ่มตลอดเวลา
		if math.random(1, 8) == 1 then
			staticOverlay.BackgroundColor3 = math.random(0, 1) == 0 and Color3.fromRGB(30, 200, 70) or Color3.fromRGB(10, 40, 20)
			staticOverlay.BackgroundTransparency = math.random(80, 95) / 100
		end
	end)
end

function stopDroneControl()
	if not isControlling then return end
	isControlling = false
	hackerGui.Enabled = false

	if droneConnection then
		droneConnection:Disconnect()
		droneConnection = nil
	end

	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- ==========================================
-- 7. สร้างไอเทมชิ้นที่ 1: โดรน (Deploy Drone Tool)
-- ==========================================
local function createDeployTool()
	local tool = Instance.new("Tool")
	tool.Name = "Deploy Drone"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1.2, 0.6, 1.2)
	handle.Color = Color3.fromRGB(40, 40, 45)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool

	tool.Activated:Connect(function()
		local char = player.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end
		local root = char.HumanoidRootPart

		if deployedDrone then deployedDrone:Destroy() end
		
		-- วางโดรนไว้ข้างหน้าผู้เล่น
		local spawnCF = root.CFrame * CFrame.new(0, 0, -5) + Vector3.new(0, 2, 0)
		deployedDrone = createDroneModel(spawnCF)
	end)

	tool.Parent = player:WaitForChild("Backpack")
	droneTool = tool
end

-- ==========================================
-- 8. สร้างไอเทมชิ้นที่ 2: รีโมท (Remote Control Tool)
-- ==========================================
local function createRemoteTool()
	local tool = Instance.new("Tool")
	tool.Name = "Drone Remote"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.6, 0.2, 1.0)
	handle.Color = Color3.fromRGB(200, 50, 50)
	handle.Material = Enum.Material.SmoothPlastic
	handle.Parent = tool

	tool.Equipped:Connect(function()
		if deployedDrone then
			startDroneControl()
		else
			print("ยังไม่ได้วางโดรน!")
		end
	end)

	tool.Unequipped:Connect(function()
		stopDroneControl()
	end)

	tool.Parent = player:WaitForChild("Backpack")
	remoteTool = tool
end

-- เริ่มสร้างไอเทมทั้งหมดให้ตัวละคร
task.spawn(function()
	task.wait(1)
	createDeployTool()
	createRemoteTool()
end)

player.CharacterAdded:Connect(function()
	stopDroneControl()
	if deployedDrone then
		deployedDrone:Destroy()
		deployedDrone = nil
	end
	task.wait(1)
	createDeployTool()
	createRemoteTool()
end)
