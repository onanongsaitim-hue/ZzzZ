-- 5. เอฟเฟกต์แฟลชแบ็กภาพซ่า
-- ==========================================
local function playStaticFlashback(onReady)
	flashScreen.Visible = true
	
	task.spawn(function()
		for i = 1, 15 do
			flashScreen.BackgroundColor3 = math.random(0, 1) == 0 and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(15, 15, 15)
			flashScreen.BackgroundTransparency = 0.05
			task.wait(0.04)
		end
		
		for i = 1, 15 do
			flashScreen.BackgroundColor3 = math.random(0, 1) == 0 and Color3.fromRGB(40, 220, 80) or Color3.fromRGB(10, 50, 20)
			flashScreen.BackgroundTransparency = 0.1
			task.wait(0.04)
		end

		TweenService:Create(flashScreen, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
		task.wait(0.4)
		flashScreen.Visible = false
		if onReady then onReady() end
	end)
end

