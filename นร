-- 8. สร้างไอเทมชิ้นที่ 1: โดรน (Deploy Drone Tool)
-- ==========================================
local function createDeployTool()
	local tool = Instance.new("Tool")
	tool.Name = "Deploy Drone"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1.2, 0.6, 1.2)
	handle.Color = Color3.fromRGB(40, 40, 45)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool

	tool.Activated:Connect(function()
		local char = player.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end
		local root = char.HumanoidRootPart

		if deployedDrone then deployedDrone:Destroy() end
		
		local spawnCF = root.CFrame * CFrame.new(0, 0, -5) + Vector3.new(0, 2, 0)
		deployedDrone = createDroneModel(spawnCF)
	end)

	tool.Parent = player:WaitForChild("Backpack")
	droneTool = tool
end

-- ==========================================
-- 9. สร้างไอเทมชิ้นที่ 2: รีโมท (Remote Control Tool)
-- ==========================================
local function createRemoteTool()
	local tool = Instance.new("Tool")
	tool.Name = "Drone Remote"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.6, 0.2, 1.0)
	handle.Color = Color3.fromRGB(200, 50, 50)
	handle.Material = Enum.Material.SmoothPlastic
	handle.Parent = tool

	tool.Equipped:Connect(function()
		if deployedDrone then
			startDroneControl()
		else
			print("ยังไม่ได้วางโดรน!")
		end
	end)

	tool.Unequipped:Connect(function()
		stopDroneControl()
	end)

	tool.Parent = player:WaitForChild("Backpack")
	remoteTool = tool
end

-- เริ่มสร้างไอเทมทั้งหมดให้ตัวละคร
task.spawn(function()
	task.wait(1)
	createDeployTool()
	createRemoteTool()
end)

player.CharacterAdded:Connect(function()
	stopDroneControl()
	if deployedDrone then
		deployedDrone:Destroy()
		deployedDrone = nil
	end
	task.wait(1)
	createDeployTool()
	createRemoteTool()
end)
