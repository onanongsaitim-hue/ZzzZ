-- ระบบลากจุดสีแดงในแป้นขวาบน (Joystick)
redButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingRedBtn = true
		activeTouch = input
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == activeTouch then
		isDraggingRedBtn = false
		activeTouch = nil
		aimInputX = 0
		aimInputY = 0
		TweenService:Create(redButton, TweenInfo.new(0.1), {Position = UDim2.new(0.5, -22, 0.5, -22)}):Play()
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingRedBtn and input == activeTouch then
		local absPos = turnPad.AbsolutePosition
		local absSize = turnPad.AbsoluteSize
		local center = absPos + (absSize / 2)
		local mousePos = input.Position
		
		local offset = Vector2.new(mousePos.X - center.X, mousePos.Y - center.Y)
		local maxDist = absSize.X / 2 - 22
		
		if offset.Magnitude > maxDist then
			offset = offset.Unit * maxDist
		end
		
		redButton.Position = UDim2.new(0.5, offset.X - 22, 0.5, offset.Y - 22)
		aimInputX = offset.X / maxDist
		aimInputY = offset.Y / maxDist
	end
end)

