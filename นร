-- 6. สร้างโมเดลโดรน (พร้อมกล้องใต้ท้องและเลนส์สีแดง)
-- ==========================================
local function createDroneModel(cframe)
	local model = Instance.new("Model")
	model.Name = "SquareDrone"

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.new(2, 0.8, 2)
	core.Color = Color3.fromRGB(30, 30, 35)
	core.Material = Enum.Material.Neon
	core.CFrame = cframe
	core.CanCollide = true
	core.Parent = model
	model.PrimaryPart = core

	local cameraLens = Instance.new("Part")
	cameraLens.Name = "CameraLens"
	cameraLens.Size = Vector3.new(0.6, 0.4, 0.6)
	cameraLens.Color = Color3.fromRGB(20, 20, 20)
	cameraLens.Material = Enum.Material.SmoothPlastic
	cameraLens.CanCollide = false
	cameraLens.Parent = model

	local lensWeld = Instance.new("WeldConstraint")
	lensWeld.Part0 = core
	lensWeld.Part1 = cameraLens
	lensWeld.Parent = core
	cameraLens.CFrame = core.CFrame * CFrame.new(0, -0.6, 0)

	local lensGlass = Instance.new("Part")
	lensGlass.Size = Vector3.new(0.3, 0.3, 0.3)
	lensGlass.Color = Color3.fromRGB(255, 50, 50)
	lensGlass.Material = Enum.Material.Glass
	lensGlass.CanCollide = false
	lensGlass.Parent = model

	local glassWeld = Instance.new("WeldConstraint")
	glassWeld.Part0 = cameraLens
	glassWeld.Part1 = lensGlass
	glassWeld.Parent = cameraLens
	lensGlass.CFrame = cameraLens.CFrame * CFrame.new(0, 0, -0.3)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(50, 255, 100)
	light.Brightness = 3
	light.Range = 10
	light.Parent = core

	model.Parent = workspace
	return model
end

-- ==========================================
-- 7. ฟังก์ชันควบคุมการบินโดรน (บินตามมุมมองกล้องขึ้น/ลง + ปรับความเร็ว)
-- ==========================================
local function startDroneControl()
	if not deployedDrone or not deployedDrone.PrimaryPart then return end
	
	playStaticFlashback(function()
		isControlling = true
		hackerGui.Enabled = true
		camera.CameraType = Enum.CameraType.Scriptable
	end)

	local dronePart = deployedDrone.PrimaryPart
	local currentPos = dronePart.Position
	local currentYaw = 0
	local currentPitch = 0
	local currentTiltPitch = 0 
	local currentTiltRoll = 0  

	local turnSpeed = 2.8
	local pitchSpeed = 2.0
	local shakeTimer = 0

	if droneConnection then droneConnection:Disconnect() end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.IgnoreWater = true

	droneConnection = RunService.RenderStepped:Connect(function(dt)
		if not deployedDrone or not deployedDrone.Parent or not isControlling then return end

		local ignoreList = {player.Character, deployedDrone}
		raycastParams.FilterDescendantsInstances = ignoreList

		-- 1. ควบคุมการหันกล้องและเลี้ยว
		if turnLeft then currentYaw = currentYaw + (turnSpeed * dt) end
		if turnRight then currentYaw = currentYaw - (turnSpeed * dt) end

		if math.abs(aimInputX) > 0.05 then
			currentYaw = currentYaw - (aimInputX * turnSpeed * dt * 1.5)
		end
		if math.abs(aimInputY) > 0.05 then
			currentPitch = math.clamp(currentPitch - (aimInputY * pitchSpeed * dt * 1.5), math.rad(-80), math.rad(80))
		end

		-- ทิศทางเต็มรูปแบบรวมทั้งมุมก้ม-เงย (LookVector จะชี้ขึ้นฟ้าหรือลงดินตามกล้อง)
		local lookRotCF = CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, 0)
		local aimForwardVec = lookRotCF.LookVector

		-- 2. คำนวณการเคลื่อนที่ตามทิศที่หน้าโดรนหันอยู่ (หันขึ้นบินขึ้น หันลงบินลง)
		local moveVector = Vector3.new(0, 0, 0)
		if moveForward then moveVector = moveVector + aimForwardVec end
		if moveBackward then moveVector = moveVector - aimForwardVec end

		local intendedPos = currentPos + (moveVector * droneSpeed * dt)

		-- 3. ระบบเช็คชนกำแพง (Raycast Collision)
		local direction = intendedPos - currentPos
		local distance = direction.Magnitude

		if distance > 0.001 then
			local rayResult = workspace:Raycast(currentPos, direction.Unit * (distance + 1.2), raycastParams)
			if rayResult then
				shakeTimer = 0.35 
			else
				currentPos = intendedPos
			end
		else
			currentPos = intendedPos
		end

		-- 4. ระบบคำนวณองศาการเอียงตัว (เดินหน้าหัวกดลง / ถอยหลังหัวเงยขึ้น)
		local targetTiltPitch = 0
		if moveForward then 
			targetTiltPitch = math.rad(-16)
		elseif moveBackward then 
			targetTiltPitch = math.rad(16)
		end

		local targetTiltRoll = 0
		if turnLeft or aimInputX < -0.1 then targetTiltRoll = math.rad(22)
		elseif turnRight or aimInputX > 0.1 then targetTiltRoll = math.rad(-22) end

		currentTiltPitch = currentTiltPitch + (targetTiltPitch - currentTiltPitch) * math.clamp(dt * 12, 0, 1)
		currentTiltRoll = currentTiltRoll + (targetTiltRoll - currentTiltRoll) * math.clamp(dt * 12, 0, 1)

		local finalRotCF = CFrame.Angles(0, currentYaw, 0) 
			* CFrame.Angles(currentPitch + currentTiltPitch, 0, currentTiltRoll)

		local targetCF = CFrame.new(currentPos) * finalRotCF
		deployedDrone:SetPrimaryPartCFrame(targetCF)

		-- 5. เอฟเฟกต์กล้องสั่นเมื่อชนกำแพง
		local camOffset = CFrame.new(0, 0.4, 0)
		if shakeTimer > 0 then
			shakeTimer = shakeTimer - dt
			local intensity = 0.45
			camOffset = camOffset * CFrame.new(
				math.random(-100, 100) / 100 * intensity,
				math.random(-100, 100) / 100 * intensity,
				math.random(-100, 100) / 100 * intensity
			)
		end

		camera.CFrame = targetCF * camOffset

		if math.random(1, 8) == 1 then
			staticOverlay.BackgroundColor3 = math.random(0, 1) == 0 and Color3.fromRGB(30, 200, 70) or Color3.fromRGB(10, 40, 20)
			staticOverlay.BackgroundTransparency = math.random(80, 95) / 100
		end
	end)
end

function stopDroneControl()
	if not isControlling then return end
	isControlling = false
	hackerGui.Enabled = false

	if droneConnection then
		droneConnection:Disconnect()
		droneConnection = nil
	end

	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

