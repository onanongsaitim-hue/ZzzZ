-- ตัวแปรเก็บสถานะ
local isFlying = false
local waistPart = nil
local backModel = nil
local currentTool = nil
local activeProjectile = nil
local flightConnection = nil

-- ล้าง UI เก่าเผื่อรันซ้ำ
