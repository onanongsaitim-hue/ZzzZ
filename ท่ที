-- อัปเดตการทำงานทุกเฟรม (พร้อมระบบลอยตัว Hover ไม่ให้จมดิน)
local loopConnection
loopConnection = RunService.Heartbeat:Connect(function(dt)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if isEnabled and char and hum then
		hum.WalkSpeed = 300
		ColorEffect.Enabled = true
		
		if hum.MoveDirection.Magnitude > 0 then
			spawnTimer = spawnTimer + dt
			if spawnTimer >= spawnInterval then
				spawnTimer = 0
				createAfterimage(char)
			end
		end
	end

	-- คำนวณตำแหน่งให้ลอยตามหลังขวาแบบสมูท พร้อมเอฟเฟกต์ลอยขึ้นลง (Hover) ป้องกันการจมพื้น
	if girlEnabled and root and girlModel and girlModel:FindFirstChild("HumanoidRootPart") then
		local hoverEffect = math.sin(tick() * 5) * 0.3 -- ขยับขึ้นลงเบาๆ
		local targetCFrame = root.CFrame * CFrame.new(2.5, 0.8 + hoverEffect, 3.2)
		girlModel.HumanoidRootPart.CFrame = girlModel.HumanoidRootPart.CFrame:Lerp(targetCFrame, 0.25)
	end
end)

-- ปุ่มกดเปิด/ปิด ฟังก์ชันที่ 1 (ความเร็ว)
ToggleBtn.MouseButton1Click:Connect(function()
	isEnabled = not isEnabled
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	
	if isEnabled then
		ToggleBtn.Text = "ความเร็ว : เปิด"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 90)
		ColorEffect.Enabled = true
		playShockwave()
		playWhiteStars()
		if char then
			createSpine(char)
		end
	else
		ToggleBtn.Text = "ความเร็ว : ปิด"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
		ColorEffect.Enabled = false
		clearAllClones()
		removeSpine()
		playShockwave()
		if hum then
			hum.WalkSpeed = 16
		end
	end
end)

