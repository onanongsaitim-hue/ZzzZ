local spineModel = nil

local function createSpine(char)
	if spineModel then spineModel:Destroy() end
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not torso then return end

	spineModel = Instance.new("Model")
	spineModel.Name = "BlackSpine"

	for i = -2, 2 do
		local bone = Instance.new("Part")
		bone.Size = Vector3.new(0.35, 0.25, 0.25)
		bone.Color = Color3.fromRGB(0, 0, 0)
		bone.Material = Enum.Material.SmoothPlastic
		bone.CanCollide = false
		bone.Massless = true
		bone.CFrame = torso.CFrame * CFrame.new(0, i * 0.3, 0.6)
		bone.Parent = spineModel

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = bone
		weld.Parent = bone
	end

	spineModel.Parent = char
end

local function removeSpine()
	if spineModel then
		spineModel:Destroy()
		spineModel = nil
	end
end

local RainbowColors = {
	Color3.fromRGB(0, 255, 0),     -- 1. เขียว
	Color3.fromRGB(0, 255, 255),   -- 2. ฟ้า
	Color3.fromRGB(0, 100, 255),   -- 3. น้ำเงิน
	Color3.fromRGB(180, 0, 255),   -- 4. ม่วง
	Color3.fromRGB(255, 0, 120),   -- 5. ชมพู/แดง
	Color3.fromRGB(255, 128, 0),   -- 6. ส้ม
	Color3.fromRGB(255, 255, 0)    -- 7. เหลือง
}

local isEnabled = false
local colorIndex = 1
local activeClones = {}
local spawnTimer = 0
local spawnInterval = 0.04
local maxClones = 20

local function createAfterimage(char)
	if #activeClones >= maxClones then
		local oldestClone = table.remove(activeClones, 1)
		if oldestClone and oldestClone.Parent then
			oldestClone:Destroy()
		end
	end

	local cloneModel = Instance.new("Model")
	cloneModel.Name = "Afterimage"
	
	local currentColor = RainbowColors[colorIndex]
	colorIndex = (colorIndex % #RainbowColors) + 1

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local clonedPart = Instance.new("Part")
			clonedPart.Size = part.Size
			clonedPart.CFrame = part.CFrame
			clonedPart.Anchored = true
			clonedPart.CanCollide = false
			clonedPart.Material = Enum.Material.Neon
			clonedPart.Color = currentColor
			clonedPart.Transparency = 0.4
			clonedPart.Parent = cloneModel
		end
	end

	cloneModel.Parent = CloneFolder
	table.insert(activeClones, cloneModel)
end

local function clearAllClones()
	for _, clone in ipairs(activeClones) do
		if clone and clone.Parent then
			clone:Destroy()
		end
	end
	table.clear(activeClones)
	colorIndex = 1
end

-- 5. ฟังก์ชันที่ 2: สร้างตัวละคร Roblox Girl ดีเทลจัดเต็ม (แก้ปัญหาจมดิน + เพิ่มทรงผมหนามแหลมและแหวนพลังงานออร่า)
local girlEnabled = false
local girlModel = nil

local function createGirlCompanion()
	if girlModel then girlModel:Destroy() end

	girlModel = Instance.new("Model")
	girlModel.Name = "RobloxGirlCompanion"

	local rootPart = Instance.new("Part")
	rootPart.Name = "HumanoidRootPart"
	rootPart.Size = Vector3.new(2, 2, 1)
	rootPart.Transparency = 1
	rootPart.CanCollide = false
	rootPart.Anchored = false
	rootPart.Parent = girlModel

	-- ลำตัว
	local upperTorso = Instance.new("Part")
	upperTorso.Size = Vector3.new(1.4, 1.1, 0.8)
	upperTorso.Color = Color3.fromRGB(15, 15, 15)
	upperTorso.Material = Enum.Material.Neon
	upperTorso.CanCollide = false
	upperTorso.Parent = girlModel

	local lowerTorso = Instance.new("Part")
	lowerTorso.Size = Vector3.new(1.3, 0.9, 0.8)
	lowerTorso.Color = Color3.fromRGB(0, 255, 128)
	lowerTorso.Material = Enum.Material.Neon
	lowerTorso.CanCollide = false
	lowerTorso.Parent = girlModel

	-- หัวและทรงผมแหลมสไตล์อนิเมะไซเบอร์
	local head = Instance.new("Part")
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Color = Color3.fromRGB(245, 205, 175)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Parent = girlModel

	local hair = Instance.new("Part")
	hair.Size = Vector3.new(1.6, 1.8, 1.6)
	hair.Color = Color3.fromRGB(255, 0, 127)
	hair.Material = Enum.Material.Neon
	hair.CanCollide = false
	hair.Parent = girlModel

	-- เพิ่มหนามผมด้านหลังให้เข้ากับเรฟรูปภาพ
	for i = 1, 3 do
		local spike = Instance.new("Part")
		spike.Size = Vector3.new(0.4, 1.2, 0.4)
		spike.Color = Color3.fromRGB(255, 0, 127)
		spike.Material = Enum.Material.Neon
		spike.CanCollide = false
		spike.Parent = girlModel
		
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = spike
		spike.CFrame = head.CFrame * CFrame.new((i - 2) * 0.5, 0.8, -0.6) * CFrame.Angles(math.rad(30), 0, 0)
		w.Parent = head
	end

	-- แขนและขา
	local leftArm = Instance.new("Part")
	leftArm.Size = Vector3.new(0.8, 1.8, 0.8)
	leftArm.Color = Color3.fromRGB(255, 0, 127)
	leftArm.Material = Enum.Material.Neon
	leftArm.CanCollide = false
	leftArm.Parent = girlModel

	local rightArm = Instance.new("Part")
	rightArm.Size = Vector3.new(0.8, 1.8, 0.8)
	rightArm.Color = Color3.fromRGB(255, 0, 127)
	rightArm.Material = Enum.Material.Neon
	rightArm.CanCollide = false
	rightArm.Parent = girlModel

	local leftLeg = Instance.new("Part")
	leftLeg.Size = Vector3.new(0.9, 1.9, 0.9)
	leftLeg.Color = Color3.fromRGB(0, 255, 128)
	leftLeg.Material = Enum.Material.Neon
	leftLeg.CanCollide = false
	leftLeg.Parent = girlModel

	local rightLeg = Instance.new("Part")
	rightLeg.Size = Vector3.new(0.9, 1.9, 0.9)
	rightLeg.Color = Color3.fromRGB(0, 255, 128)
	rightLeg.Material = Enum.Material.Neon
	rightLeg.CanCollide = false
	rightLeg.Parent = girlModel

	local function weld(p0, p1, c0)
		local w = Instance.new("WeldConstraint")
		w.Part0 = p0
		w.Part1 = p1
		p1.CFrame = p0.CFrame * c0
		w.Parent = p0
	end

	weld(rootPart, upperTorso, CFrame.new(0, 0.5, 0)) -- ปรับยกระดับแกนกลางขึ้นเพื่อไม่ให้จมดิน
	weld(upperTorso, lowerTorso, CFrame.new(0, -0.9, 0))
	weld(upperTorso, head, CFrame.new(0, 1.4, 0))
	weld(head, hair, CFrame.new(0, 0.1, 0))
	weld(upperTorso, leftArm, CFrame.new(-1.1, 0, 0))
	weld(upperTorso, rightArm, CFrame.new(1.1, 0, 0))
	weld(lowerTorso, leftLeg, CFrame.new(-0.45, -1.3, 0))
	weld(lowerTorso, rightLeg, CFrame.new(0.45, -1.3, 0))

	girlModel.Parent = workspace
end

