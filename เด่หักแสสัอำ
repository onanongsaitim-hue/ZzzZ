-- ลูปสร้างเงาสายรุ้ง (เริ่มจากสีเขียวแล้วไล่สีรุ้ง ค้างไว้ 5 วินาที) และเอฟเฟกต์กริต
local hueTimer = 0.33 -- เริ่มต้นที่โทนสีเขียว
local lastCloneTick = 0

RunService.RenderStepped:Connect(function(dt)
	if currentLevel > 0 then
		-- หมุนเวียนสีขอบกรอบสายรุ้ง
		hueTimer = (hueTimer + dt * 1.5) % 1
		floatGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(hueTimer, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hueTimer + 0.5) % 1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(hueTimer, 1, 1))
		})
		
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local root = char.HumanoidRootPart
			
			-- สร้างเงาตัวละครเดินตามเมื่อตัวละครขยับ
			if root.Velocity.Magnitude > 10 and (tick() - lastCloneTick > 0.12) then
				lastCloneTick = tick()
				
				local cloneColor = Color3.fromHSV(hueTimer, 1, 1)
				
				char.Archivable = true
				local clone = char:Clone()
				char.Archivable = false
				
				for _, part in ipairs(clone:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = false
						part.Material = Enum.Material.Neon
						part.Color = cloneColor
						part.Transparency = 0.3
					elseif part:IsA("Script") or part:IsA("LocalScript") or part:IsA("Humanoid") then
						part:Destroy()
					end
				end
				clone.Parent = workspace
				
				-- เงาสายรุ้งจะอยู่นิ่งค้างไว้ 5 วินาทีเต็ม แล้วค่อยจางหายไป
				task.delay(5, function()
					if clone then
						local tween = TweenService:Create(clone:FindFirstChildOfClass("BasePart") or clone, TweenInfo.new(0.8), {Transparency = 1})
						tween:Play()
						tween.Completed:Connect(function()
							clone:Destroy()
						end)
					end
				end)
			end
			
			-- เอฟเฟกต์กริต (Glitch) หัวและตารวน
			local head = char:FindFirstChild("Head")
			if head then
				if currentLevel == 2 then
					head.Position = head.Position + Vector3.new(math.random(-1,1)*0.08, math.random(-1,1)*0.08, math.random(-1,1)*0.08)
				elseif currentLevel == 3 then
					head.Position = head.Position + Vector3.new(math.random(-3,3)*0.2, math.random(-3,3)*0.2, math.random(-3,3)*0.2)
				end
			end
		end
	end
end)
