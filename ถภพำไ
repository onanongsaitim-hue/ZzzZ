-- ==========================================
-- 3. ระบบลากหน้าต่าง (Draggable)
-- ==========================================
local dragging, dragInput, dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainWindow.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

RunService.RenderStepped:Connect(function()
	if dragging and dragInput then
		local delta = dragInput.Position - dragStart
		mainWindow.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- ==========================================
-- 4. ระบบเอฟเฟกต์บูสต์วิ่ง (Levels & Effects)
-- ==========================================
local currentBoostLevel = 0

-- สร้าง ColorCorrection สำหรับทำให้จอเป็นสีเทา
local colorCorrection = Lighting:FindFirstChild("CyberpunkCC") or Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "CyberpunkCC"
colorCorrection.Parent = Lighting
colorCorrection.Enabled = false
colorCorrection.Saturation = -1 -- ทำให้โลกเป็นสีเทา

-- ฟังก์ชันจัดการเอฟเฟกต์การวิ่ง
local function applyBoost(level)
	currentBoostLevel = level
	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	if level == 0 then
		humanoid.WalkSpeed = 16
		colorCorrection.Enabled = false
	elseif level == 1 then
		humanoid.WalkSpeed = 60
		colorCorrection.Enabled = true
	elseif level == 2 then
		humanoid.WalkSpeed = 180
		colorCorrection.Enabled = true
	elseif level == 3 then
		humanoid.WalkSpeed = 500
		colorCorrection.Enabled = true
	end
end

-- กดปุ่มในหน้าต่างหลักเพื่อเปิด HUD ขวาบน และเริ่มเลเวล 1 อัตโนมัติ
boostMenuBtn.MouseButton1Click:Connect(function()
	mainWindow.Visible = false
	hudFrame.Visible = true
	applyBoost(1)
end)

-- ปุ่มเลือกเลเวลใน HUD ขวาบน
btnLvl1.MouseButton1Click:Connect(function() applyBoost(1) end)
btnLvl2.MouseButton1Click:Connect(function() applyBoost(2) end)
btnLvl3.MouseButton1Click:Connect(function() applyBoost(3) end)

-- ลูปสร้างเงาสายรุ้ง (Trail / Afterimage) และเอฟเฟกต์รวน (Glitch)
local rainbowHue = 0
local lastCloneTime = 0

RunService.RenderStepped:Connect(function(dt)
	if currentBoostLevel > 0 then
		rainbowHue = (rainbowHue + dt * 2) % 1
		local rainbowColor = Color3.fromHSV(rainbowHue, 1, 1)
		
		-- อัปเดตสีขอบ HUD เป็นสายรุ้งวิ่ง
		hudGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(rainbowHue, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHSV((rainbowHue + 0.5) % 1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(rainbowHue, 1, 1))
		})
		
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local root = char.HumanoidRootPart
			
			-- สร้างเงาสายรุ้งตามตัวเมื่อเคลื่อนที่
			if root.Velocity.Magnitude > 15 and (tick() - lastCloneTime > 0.15) then
				lastCloneTime = tick()
				char.Archivable = true
				local clone = char:Clone()
				char.Archivable = false
				
				for _, part in ipairs(clone:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = true
						part.CanCollide = false
						part.Material = Enum.Material.Neon
						part.Color = rainbowColor
						part.Transparency = 0.4
					elseif part:IsA("Script") or part:IsA("LocalScript") or part:IsA("Humanoid") then
						part:Destroy()
					end
				end
				clone.Parent = workspace
				
				-- เงาเลเวล 3 จะอยู่นิ่งค้าง 3 วินาทีแล้วหายไป
				if currentBoostLevel == 3 then
					task.delay(3, function()
						if clone then
							TweenService:Create(clone:FindFirstChildOfClass("BasePart") or clone, TweenInfo.new(0.5), {Transparency = 1}):Play()
							task.wait(0.5)
							clone:Destroy()
						end
					end)
				else
					-- เลเวล 1 และ 2 ค่อยๆ จางหายไปใน 0.4 วินาที
					task.delay(0.1, function()
						if clone then
							clone:Destroy()
						end
					end)
				end
			end
			
			-- เอฟเฟกต์ตารวน / หัวรวน (Glitch) ในเลเวล 2 และ 3
			if currentBoostLevel >= 2 then
				local head = char:FindFirstChild("Head")
				if head then
					head.Position = head.Position + Vector3.new(math.random(-2,2)*0.05, math.random(-2,2)*0.05, math.random(-2,2)*0.05)
				end
			end
		end
	end
end)
