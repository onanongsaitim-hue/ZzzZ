-- VEHICLE ENGINE & LED WHEEL ATTACHMENT LOOP
---------------------------------------------------------
local function FindCarWheels(car)
    local wheels = {}
    for _, part in pairs(car:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if name:find("wheel") or name:find("tire") or name:find("rim") or name:find("ล้อ") then
                table.insert(wheels, part)
            end
        end
    end
    return wheels
end

local ledHue = 0
RunService.RenderStepped:Connect(function()
    ledHue = (ledHue + 0.01) % 1
    local rainbowColor = Color3.fromHSV(ledHue, 0.9, 1)

    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
            local seat = hum.SeatPart
            local car = seat:FindFirstAncestorOfClass("Model") or seat.Parent

            ---------------------------------------------------------
            -- A. Speed & Boost System
            ---------------------------------------------------------
            if State.VehicleBoostEnabled then
                seat.MaxSpeed = State.VehicleSpeed
                seat.Torque = State.VehicleSpeed * 10
                if seat.Throttle ~= 0 then
                    seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (seat.Throttle * State.VehicleSpeed)
                end
            end

            ---------------------------------------------------------
            -- B. Height Control (โหลดเตี้ย / ยกสูง)
            ---------------------------------------------------------
            if car then
                for _, spring in pairs(car:GetDescendants()) do
                    if spring:IsA("SpringConstraint") then
                        spring.FreeLength = math.max(0.1, State.VehicleSuspension + State.VehicleHeight)
                    end
                end
            end

            ---------------------------------------------------------
            -- C. Wheels LED & Stance Extension (หมุนตามล้อ + ยืดล้อหลัง)
            ---------------------------------------------------------
            if car then
                local wheels = FindCarWheels(car)
                local ledFolder = car:FindFirstChild("ZzzZ_WheelLEDs")

                if State.VehicleLEDEnabled then
                    if not ledFolder then
                        ledFolder = Instance.new("Folder")
                        ledFolder.Name = "ZzzZ_WheelLEDs"
                        ledFolder.Parent = car

                        for _, wheel in ipairs(wheels) do
                            -- สร้างจุดไฟรอบล้อ (วงแหวน 4 จุดต่อ 1 ล้อ)
                            local angles = {0, math.pi/2, math.pi, math.pi*1.5}
                            for index, angle in ipairs(angles) do
                                local ledPart = Instance.new("Part")
                                ledPart.Name = wheel.Name .. "_LED_" .. index
                                ledPart.Size = Vector3.new(0.3, 0.3, 0.3)
                                ledPart.Material = Enum.Material.Neon
                                
                                -- 🔒 ป้องกันรถกระเด็น/ตกโลก 100%
                                ledPart.CanCollide = false
                                ledPart.CanTouch = false
                                ledPart.CanQuery = false
                                ledPart.Massless = true
                                ledPart.Transparency = 0.1
                                ledPart.Parent = ledFolder

                                local light = Instance.new("PointLight")
                                light.Name = "LEDLight"
                                light.Range = 8
                                light.Brightness = 4
                                light.Parent = ledPart

                                -- เชื่อมติดกับล้อจริง เพื่อให้หมุนไปพร้อมล้อ
                                local weld = Instance.new("WeldConstraint")
                                weld.Part0 = wheel
                                weld.Part1 = ledPart
                                weld.Parent = ledPart

                                -- จัดตำแหน่งติดขอบล้อ
                                local radius = wheel.Size.Y / 2
                                local offsetX = math.cos(angle) * radius
                                local offsetY = math.sin(angle) * radius
                                ledPart.CFrame = wheel.CFrame * CFrame.new(offsetX, offsetY, 0)
                            end
                        end
                    end

                    -- อัปเดตสีรุ้งให้หลอดไฟติดล้อ
                    for _, child in pairs(ledFolder:GetChildren()) do
                        if child:IsA("BasePart") then
                            child.Color = rainbowColor
                            local light = child:FindFirstChild("LEDLight")
                            if light then light.Color = rainbowColor end
                        end
                    end
                else
                    if ledFolder then ledFolder:Destroy() end
                end

                ---------------------------------------------------------
                -- D. Rear Wheel Extension (ยืดล้อหลังยาวออกมา)
                ---------------------------------------------------------
                for _, wheel in ipairs(wheels) do
                    local name = wheel.Name:lower()
                    if name:find("rear") or name:find("back") or name:find("หลัง") then
                        -- ถ่างขยายระยะตำแหน่งล้อหลังออกทางด้านข้าง
                        local isRight = wheel.Position.X > seat.Position.X
                        local extensionOffset = isRight and State.RearWheelExtension or -State.RearWheelExtension
                        
                        -- ปรับตำแหน่ง Weld / CFrame สำหรับถ่างล้อ
                        for _, joint in pairs(wheel:GetJoints()) do
                            if joint:IsA("Weld") or joint:IsA("Motor6D") then
                                joint.C0 = CFrame.new(extensionOffset, 0, 0)
                            end
                        end
                    end
                end

            end

        end
    end
end)

