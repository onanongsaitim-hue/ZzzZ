local function weldPart(part, mainBody, canCollide)
	part.Anchored = false
	part.Massless = true
	part.CanCollide = canCollide
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = mainBody
	weld.Part1 = part
	weld.Parent = mainBody
end

