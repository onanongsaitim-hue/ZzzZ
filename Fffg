            if (State.ESPEnabled or State.ESPNames) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                local char = player.Character
                local hum = char.Humanoid
                
                if hum.Health > 0 then
                    -- Highlight ESP
                    if State.ESPEnabled then
                        local hl = char:FindFirstChild("ZzzZ_Highlight")
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Name = "ZzzZ_Highlight"
                            hl.FillColor = State.ESPColor
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.4
                            hl.OutlineTransparency = 0
                            hl.Parent = char
                        end
                    else
                        local hl = char:FindFirstChild("ZzzZ_Highlight")
                        if hl then hl:Destroy() end
                    end

                    -- ESP Name Tag
                    if State.ESPNames then
                        local bgui = char:FindFirstChild("ZzzZ_ESP_Tag")
                        if not bgui then
                            bgui = Instance.new("BillboardGui")
                            bgui.Name = "ZzzZ_ESP_Tag"
                            bgui.AlwaysOnTop = true
                            bgui.Size = UDim2.new(0, 150, 0, 30)
                            bgui.StudsOffset = Vector3.new(0, 3, 0)
                            bgui.Adornee = char:FindFirstChild("Head") or char.HumanoidRootPart

                            local nameLabel = Instance.new("TextLabel")
                            nameLabel.Name = "Label"
                            nameLabel.Size = UDim2.new(1, 0, 1, 0)
                            nameLabel.BackgroundTransparency = 1
                            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            nameLabel.Font = Enum.Font.SourceSansBold
                            nameLabel.TextSize = 13
                            nameLabel.TextStrokeTransparency = 0
                            nameLabel.Parent = bgui

                            bgui.Parent = char
                        end

                        if bgui:FindFirstChild("Label") then
                            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local dist = myHRP and math.floor((char.HumanoidRootPart.Position - myHRP.Position).Magnitude) or 0
                            bgui.Label.Text = player.DisplayName .. " [" .. math.floor(hum.Health) .. " HP] (" .. dist .. "m)"
                        end
                    else
                        local bgui = char:FindFirstChild("ZzzZ_ESP_Tag")
                        if bgui then bgui:Destroy() end
                    end
                else
                    ClearESP(player)
                end
            else
                ClearESP(player)
            end
        end
    end
end)

-- 2. Target Lock Loop
RunService.RenderStepped:Connect(function()
    if State.SkillLockEnabled and State.SkillLockTarget then
        local targetChar = State.SkillLockTarget.Character
        local myChar = LocalPlayer.Character

        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 and myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local myHRP = myChar.HumanoidRootPart
            local targetHRP = targetChar.HumanoidRootPart

            local targetPos = targetHRP.Position
            local myPos = myHRP.Position

            local lookAtCFrame = CFrame.new(myPos, Vector3.new(targetPos.X, myPos.Y, targetPos.Z))
            myHRP.CFrame = myHRP.CFrame:Lerp(lookAtCFrame, State.LockSmoothness)

            local currentCamCFrame = Camera.CFrame
            local desiredCamCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
            Camera.CFrame = currentCamCFrame:Lerp(desiredCamCFrame, State.LockSmoothness)
        else
            State.SkillLockEnabled = false
            State.SkillLockTarget = nil
            SkillLockBtn.Text = "🎯 Target Lock: OFF"
            SkillLockBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end
end)

-- 3. Hitbox Loop
RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if State.HeadHitboxEnabled then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(State.HeadSize, State.HeadSize, State.HeadSize)
                    head.Transparency = State.HeadTransparency
                    head.Color = State.HeadColor
                    head.Material = Enum.Material.Neon
                    head.CanCollide = false
                end
            end
            
            if State.BodyHitboxEnabled then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size = Vector3.new(State.BodySize, State.BodySize, State.BodySize)
                    hrp.Transparency = State.BodyTransparency
                    hrp.Color = State.BodyColor
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                end
            end
        end
    end
end)

-- 4. Speed & Movement Loops
RunService.RenderStepped:Connect(function()
    if State.SpeedHackEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = State.WalkSpeedValue end
    end
end)

RunService.Stepped:Connect(function()
    if State.Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
