local timer = 0

RunService.RenderStepped:Connect(function()
    timer = timer + 0.05

    -- Lock Target / Aimbot (มองตามศัตรูแบบสมูทนุ่มนวล)
    if State.AimbotEnabled then
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), State.AimbotSmoothness)
        end
    end

    -- Noclip
    if State.NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- Hitbox & ESP
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                if State.HeadHitboxEnabled then
                    head.Size = Vector3.new(State.HeadSize, State.HeadSize, State.HeadSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            if plr.Character:FindFirstChild("HumanoidRootPart") then
