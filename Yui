                    hrp.Transparency = 0.6
                    hrp.Color = Color3.fromRGB(255, 0, 0)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end

            -- Highlight ESP
            local espHighlight = plr.Character:FindFirstChild("ZzzZ_ESP_Highlight")
            if State.ESP_Highlight then
                if not espHighlight then
                    espHighlight = Instance.new("Highlight")
                    espHighlight.Name = "ZzzZ_ESP_Highlight"
                    espHighlight.FillColor = Color3.fromRGB(255, 0, 80)
                    espHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    espHighlight.FillTransparency = 0.4
                    espHighlight.Parent = plr.Character
                end
            else
                if espHighlight then espHighlight:Destroy() end
            end
        end
    end

    -- Serpent Vehicle Animation (หมุนเกลียวลูกงู)
    local vModel = workspace:FindFirstChild("ZzzZ_SerpentVehicle_" .. LocalPlayer.Name)
    if vModel and vModel:FindFirstChild("MainSeat") then
        local mainSeat = vModel.MainSeat
        for i = 1, 10 do
            local block = vModel:FindFirstChild("SerpentBlock_" .. i)
            if block then
                local weld = block:FindFirstChildOfClass("Weld")
                if weld then
                    local wave = math.sin(timer * 2 + (i * 0.4)) * 0.3
                    weld.C0 = CFrame.new(wave, 0, (i - 5) * 0.9) * CFrame.Angles(0, math.rad(i * 12) + (wave * 0.5), math.rad(i * 8))
                end
                local hue = ((i / 10) + (timer * 0.2)) % 1
                block.Color = Color3.fromHSV(hue, 1, 1)
            end
        end
    end

    -- WalkSpeed
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if State.SpeedHackEnabled then
            hum.WalkSpeed = State.WalkSpeedValue
        end
    end

    -- Lighting
    if State.FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    Lighting.ClockTime = State.TimeOfDay

    -- VISUAL EFFECTS PROCESSING
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart
        local head = char:FindFirstChild("Head")

        -----------------------------------------------------
        -- 1. ปีกใหญ่พิเศษบินสมจริง (ล็อคแน่นให้อยู่ด้านหลัง 100%)
        -----------------------------------------------------
        local wingsFolder = workspace:FindFirstChild("ZzzZ_MegaBackWings_" .. LocalPlayer.Name)

        if State.RainbowWingsEnabled then
            if not wingsFolder then
                wingsFolder = Instance.new("Folder")
                wingsFolder.Name = "ZzzZ_MegaBackWings_" .. LocalPlayer.Name
                wingsFolder.Parent = workspace

                for i = 1, 40 do
                    local feather = Instance.new("Part")
                    feather.Name = "Feather_" .. i
                    feather.Size = Vector3.new(0.45, 2.2, 0.7) -- ขยายขนาดปีกให้อลังการ
                    feather.Material = Enum.Material.Neon
                    feather.Anchored = true
                    feather.CanCollide = false
                    feather.CanTouch = false
                    feather.CanQuery = false
                    feather.Parent = wingsFolder

                    local wLight = Instance.new("PointLight")
                    wLight.Name = "WingLight"
                    wLight.Range = 10
                    wLight.Brightness = 5
                    wLight.Parent = feather

                    local att0 = Instance.new("Attachment", feather)
                    att0.Position = Vector3.new(0, 0.9, 0)
                    local att1 = Instance.new("Attachment", feather)
                    att1.Position = Vector3.new(0, -0.9, 0)

                    local trail = Instance.new("Trail")
                    trail.Name = "WingTrail"
                    trail.Attachment0 = att0
                    trail.Attachment1 = att1
                    trail.Lifetime = 0.6
                    trail.FaceCamera = true
                    trail.LightEmission = 1
                    trail.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.1),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    trail.Parent = feather
                end
            end

            -- ล็อคพิกัดตำแหน่งให้อยู่ "ด้านหลัง" อย่างถูกต้อง (Back Offset = LookVector * -1.2)
            local flapAngle = math.sin(timer * 1.4) * 0.5 -- บินพือปีกนุ่มนวล ช้า สมจริง
            local backOffsetPos = hrp.CFrame.Position - (hrp.CFrame.LookVector * 1.2) + Vector3.new(0, 1.2, 0)

            for i = 1, 40 do
                local feather = wingsFolder:FindFirstChild("Feather_" .. i)
                if feather then
                    local isRight = (i <= 20)
                    local idx = isRight and i or (i - 20)
                    local sideSign = isRight and 1 or -1

                    local curveX = (idx * 0.55) * sideSign
                    local curveY = math.sin(idx * 0.2) * 1.8
                    local curveZ = -math.cos(idx * 0.1) * 0.8

                    local baseCFrame = CFrame.new(backOffsetPos) * hrp.CFrame.Rotation
                    local wingRot = CFrame.Angles(0, (flapAngle * sideSign) + (math.rad(25) * sideSign), math.rad(-15 * sideSign))
                    local featherCFrame = baseCFrame * wingRot * CFrame.new(curveX, curveY, curveZ) * CFrame.Angles(0, 0, math.rad(idx * 4 * sideSign))

                    feather.CFrame = featherCFrame

                    local hue = ((i / 40) + (timer * 0.12)) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.95, 1)

                    feather.Color = rainbowColor
                    if feather:FindFirstChild("WingLight") then feather.WingLight.Color = rainbowColor end
                    if feather:FindFirstChild("WingTrail") then feather.WingTrail.Color = ColorSequence.new(rainbowColor) end
                end
            end
        else
            if wingsFolder then wingsFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 2. มงกุฎพระราชาองค์ใหญ่ อลังการสมจริง (Ultra King Crown)
        -----------------------------------------------------
        local crownFolder = workspace:FindFirstChild("ZzzZ_UltraKingCrown_" .. LocalPlayer.Name)

        if State.RotatingCrownEnabled and head then
            if not crownFolder then
                crownFolder = Instance.new("Folder")
                crownFolder.Name = "ZzzZ_UltraKingCrown_" .. LocalPlayer.Name
                crownFolder.Parent = workspace

                -- สร้างมงกุฎใหญ่พิเศษ 28 ชิ้น
                for i = 1, 28 do
                    local cPart = Instance.new("Part")
                    cPart.Name = "CrownNode_" .. i
                    
                    if i <= 20 then
                        cPart.Size = (i % 2 == 0) and Vector3.new(0.28, 0.9, 0.3) or Vector3.new(0.22, 0.45, 0.25)
                    else
                        cPart.Size = Vector3.new(0.35, 0.35, 0.35) -- เพชรยอดมงกุฎ
                    end

                    cPart.Material = Enum.Material.Neon
                    cPart.Anchored = true
                    cPart.CanCollide = false
                    cPart.CanTouch = false
                    cPart.CanQuery = false
                    cPart.Parent = crownFolder

                    local cLight = Instance.new("PointLight")
                    cLight.Name = "CrownLight"
                    cLight.Range = 8
                    cLight.Brightness = 4
                    cLight.Parent = cPart
                end
            end

            local crownSpin = timer * 1.2
            local crownCenter = head.Position + Vector3.new(0, 1.6 + (math.sin(timer * 2) * 0.12), 0)
            local crownRadius = 1.4 -- ขยายรัศมีมงกุฎให้ใหญ่ขึ้น

            for i = 1, 28 do
                local cPart = crownFolder:FindFirstChild("CrownNode_" .. i)
                if cPart then
                    if i <= 20 then
                        local angle = crownSpin + ((i / 20) * math.pi * 2)
                        local cx = math.cos(angle) * crownRadius
                        local cz = math.sin(angle) * crownRadius
                        local cy = (i % 2 == 0) and 0.45 or 0

                        local partPos = crownCenter + Vector3.new(cx, cy, cz)
                        cPart.CFrame = CFrame.new(partPos, crownCenter + Vector3.new(0, cy, 0)) * CFrame.Angles(0, math.rad(90), 0)
                    else
                        local idx = i - 20
                        local angle = crownSpin + ((idx / 8) * math.pi * 2)
                        local cx = math.cos(angle) * (crownRadius * 0.85)
                        local cz = math.sin(angle) * (crownRadius * 0.85)
                        local cy = 0.95

                        cPart.CFrame = CFrame.new(crownCenter + Vector3.new(cx, cy, cz))
                    end

                    local hue = ((i / 28) + (timer * 0.2)) % 1
                    local rainbowColor = Color3.fromHSV(hue, 1, 1)

                    cPart.Color = rainbowColor
                    if cPart:FindFirstChild("CrownLight") then cPart.CrownLight.Color = rainbowColor end
                end
            end
        else
            if crownFolder then crownFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 3. ออร่าสีรุ้งรอบตัว (Body Aura Effect)
        -----------------------------------------------------
        local auraPart = workspace:FindFirstChild("ZzzZ_RainbowAura_" .. LocalPlayer.Name)

        if State.AuraEnabled then
            if not auraPart then
                auraPart = Instance.new("Part")
                auraPart.Name = "ZzzZ_RainbowAura_" .. LocalPlayer.Name
                auraPart.Shape = Enum.PartType.Ball
                auraPart.Size = Vector3.new(8, 8, 8)
                auraPart.Material = Enum.Material.ForceField
                auraPart.Transparency = 0.5
                auraPart.Anchored = true
                auraPart.CanCollide = false
                auraPart.CanTouch = false
                auraPart.CanQuery = false
                auraPart.Parent = workspace
            end

            auraPart.CFrame = hrp.CFrame
            local hue = (timer * 0.3) % 1
            auraPart.Color = Color3.fromHSV(hue, 1, 1)
        else
            if auraPart then auraPart:Destroy() end
        end

    end
end)

