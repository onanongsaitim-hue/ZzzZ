cloneFolder.Parent = workspace

-- ฟังก์ชันหาข้อต่อตัวละครและรีเซ็ตท่าทางให้ปกติ
local function getJoints(char)
	local neck = char:FindFirstChild("Neck", true)
	local rootJoint = char:FindFirstChild("RootJoint", true) or char:FindFirstChild("Root", true)
	if neck and not originalNeckC0 then
		originalNeckC0 = neck.C0
	end
	if rootJoint and not originalRootC0 then
		originalRootC0 = rootJoint.C0
	end
	return neck, rootJoint
end

local function resetCharacterVisuals()
	local char = player.Character
	if not char then return end
	local neck, rootJoint = getJoints(char)
	if neck and originalNeckC0 then
		neck.C0 = originalNeckC0
	end
	if rootJoint and originalRootC0 then
		rootJoint.C0 = originalRootC0
	end
	local oldHighlight = char:FindFirstChild("GlitchHighlight")
	if oldHighlight then
		oldHighlight:Destroy()
	end
end

-- อัปเดตสีปุ่มที่กำลังเลือกอยู่
local function updateButtonHighlight(lvl)
	local buttons = {
		{btn = btnLvl1, stroke = stroke1, id = 1},
		{btn = btnLvl2, stroke = stroke2, id = 2},
		{btn = btnLvl3, stroke = stroke3, id = 3},
	}
	for _, item in ipairs(buttons) do
		if item.id == lvl then
			item.btn.BackgroundColor3 = Color3.fromRGB(0, 70, 50)
			item.stroke.Thickness = 2
		else
			item.btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
			item.stroke.Thickness = 1
		end
	end
end

local function setBoostLevel(lvl)
	currentLevel = lvl
	updateButtonHighlight(lvl)
	resetCharacterVisuals()

	local char = player.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	if lvl == 0 then
		humanoid.WalkSpeed = 16
		colorCorrection.Enabled = false
	elseif lvl == 1 then
		humanoid.WalkSpeed = 100
		colorCorrection.Enabled = true
	elseif lvl == 2 then
		humanoid.WalkSpeed = 200
		colorCorrection.Enabled = true
	elseif lvl == 3 then
		humanoid.WalkSpeed = 800
		colorCorrection.Enabled = true
	end
end

