-- ลูปแสดงผลหลัก
local hueTimer = 0.33 -- เริ่มต้นที่สีเขียว
local lastCloneTick = 0

RunService.RenderStepped:Connect(function(dt)
	if currentLevel <= 0 then return end

	-- ไล่เฉดสีสายรุ้งจากสีเขียววนไปเรื่อยๆ
	hueTimer = (hueTimer + dt * 1.2) % 1
	floatGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(hueTimer, 1, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hueTimer + 0.5) % 1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(hueTimer, 1, 1))
	})

	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart

	-- 1. สร้างเงาตัวละครสีสายรุ้งตามหลังเวลาวิ่ง
	local spawnInterval = (currentLevel == 3) and 0.08 or 0.14
	if root.AssemblyLinearVelocity.Magnitude > 15 and (tick() - lastCloneTick > spawnInterval) and activeClones < MAX_CLONES then
		lastCloneTick = tick()
		activeClones += 1

		local cloneColor = Color3.fromHSV(hueTimer, 1, 1)

		char.Archivable = true
		local clone = char:Clone()
		char.Archivable = false

		local partsToFade = {}
		for _, obj in ipairs(clone:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.Anchored = true
				obj.CanCollide = false
				obj.CanQuery = false
				obj.CanTouch = false
				obj.Material = Enum.Material.Neon
				obj.Color = cloneColor
				obj.Transparency = 0.35
				table.insert(partsToFade, obj)
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = 0.5
				table.insert(partsToFade, obj)
			elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Humanoid") or obj:IsA("Sound") or obj:IsA("BillboardGui") then
				obj:Destroy()
			end
		end

		clone.Parent = cloneFolder

		-- เวล 3 ค้างนิ่งไว้ 2 วินาที / เวล 1-2 ค้างไว้ 0.6 วินาที แล้วค่อยๆ จางหายทั้งตัว
		local holdTime = (currentLevel == 3) and 2 or 0.6
		task.delay(holdTime, function()
			if clone and clone.Parent then
				for _, p in ipairs(partsToFade) do
					if p and p.Parent then
						TweenService:Create(p, TweenInfo.new(0.4), {Transparency = 1}):Play()
					end
				end
				task.wait(0.4)
				if clone then
					clone:Destroy()
				end
			end
			activeClones = math.max(0, activeClones - 1)
		end)
	end

	-- 2. เอฟเฟกต์กริต (Glitch) หัวสั่น / ตารวน / ตัวรวน (ปลอดภัย หัวไม่หลุด)
	local neck, rootJoint = getJoints(char)
	if currentLevel == 2 then
		-- เวล 2: หัวและตาสั่นรัวๆ
		if neck and originalNeckC0 then
			local rx = math.rad(math.random(-15, 15))
			local ry = math.rad(math.random(-20, 20))
			local offset = Vector3.new(math.random(-10, 10) * 0.015, math.random(-10, 10) * 0.015, 0)
			neck.C0 = originalNeckC0 * CFrame.new(offset) * CFrame.Angles(rx, ry, 0)
		end
	elseif currentLevel == 3 then
		-- เวล 3: หัวและร่างกายติดกริตหนัก + มีแสงกริตเขียว-สายรุ้งกระพริบที่ตัว
		if neck and originalNeckC0 then
			local rx = math.rad(math.random(-35, 35))
			local ry = math.rad(math.random(-45, 45))
			local rz = math.rad(math.random(-25, 25))
			local offset = Vector3.new(math.random(-10, 10) * 0.04, math.random(-10, 10) * 0.04, math.random(-10, 10) * 0.04)
			neck.C0 = originalNeckC0 * CFrame.new(offset) * CFrame.Angles(rx, ry, rz)
		end
		if rootJoint and originalRootC0 then
			local bodyOffset = Vector3.new(math.random(-10, 10) * 0.03, 0, math.random(-10, 10) * 0.03)
			rootJoint.C0 = originalRootC0 * CFrame.new(bodyOffset)
		end

		-- แสงกริตเขียว/สายรุ้งกระพริบรอบตัว
		local hl = char:FindFirstChild("GlitchHighlight") or Instance.new("Highlight")
		hl.Name = "GlitchHighlight"
		hl.Adornee = char
		hl.FillColor = Color3.fromHSV(hueTimer, 1, 1)
		hl.OutlineColor = Color3.fromRGB(0, 255, 128)
		hl.FillTransparency = (math.random() > 0.5) and 0.4 or 0.85
		hl.OutlineTransparency = 0
		hl.Parent = char
	end
end)
