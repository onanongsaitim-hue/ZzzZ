-- MAIN RENDER LOOP (EVERY FRAME)
---------------------------------------------------------
local orbitAngle = 0
RunService.RenderStepped:Connect(function()
    orbitAngle = (orbitAngle + 0.04) % (math.pi * 2)

    ---------------------------------------------------------
    -- COMBAT & HITBOX & SPEED
    ---------------------------------------------------------
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local head = plr.Character.Head
            if State.HeadHitboxEnabled then
                head.Size = Vector3.new(State.HeadSize, State.HeadSize, State.HeadSize)
                head.Transparency = 0.5
                head.CanCollide = false
            else
                head.Size = Vector3.new(1.2, 1.2, 1.2)
                head.Transparency = 0
            end
        end
    end

    if State.AimbotEnabled then
        local targetHead = GetClosestTarget()
        if targetHead then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetHead.Position), State.AimbotSmoothness)
        end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if State.SpeedHackEnabled then
            hum.WalkSpeed = State.WalkSpeedValue
        end
    end

    ---------------------------------------------------------
    -- WORLD & LIGHTING
    ---------------------------------------------------------
    if State.FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    Lighting.ClockTime = State.TimeOfDay

    ---------------------------------------------------------
    -- VEHICLE & VISUAL EFFECTS
    ---------------------------------------------------------
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")

        -- 1. บล็อกไฟตั้งหมุนเกลียวเลื้อย + ลำแสงพุ่งหลัง
        local blocksFolder = workspace:FindFirstChild("ZzzZ_SpiralLED_" .. LocalPlayer.Name)

        if State.BackLEDEnabled then
            if not blocksFolder then
                blocksFolder = Instance.new("Folder")
                blocksFolder.Name = "ZzzZ_SpiralLED_" .. LocalPlayer.Name
                blocksFolder.Parent = workspace

                for i = 1, 10 do
                    local block = Instance.new("Part")
                    block.Name = "SpiralBlock_" .. i
                    block.Size = Vector3.new(0.3, 0.8, 0.3)
                    block.Material = Enum.Material.Neon
                    block.Anchored = true
                    block.CanCollide = false
                    block.CanTouch = false
                    block.CanQuery = false
                    block.Parent = blocksFolder

                    local light = Instance.new("PointLight")
                    light.Name = "LEDLight"
                    light.Range = 8
                    light.Brightness = 4
                    light.Parent = block

                    local att0 = Instance.new("Attachment", block)
                    att0.Position = Vector3.new(0, 0.4, 0)
                    local att1 = Instance.new("Attachment", block)
                    att1.Position = Vector3.new(0, -0.4, 0)

                    local trail = Instance.new("Trail")
                    trail.Name = "LightTrail"
                    trail.Attachment0 = att0
                    trail.Attachment1 = att1
                    trail.Lifetime = 0.4
                    trail.MinLength = 0.1
                    trail.FaceCamera = true
                    trail.LightEmission = 1
                    trail.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    trail.Parent = block
                end
            end

            local centerPos = hrp.Position - (hrp.CFrame.LookVector * 1.8) + Vector3.new(0, 0.5, 0)
            local radius = 2.0

            for i = 1, 10 do
                local block = blocksFolder:FindFirstChild("SpiralBlock_" .. i)
                if block then
                    local stepAngle = orbitAngle + ((i / 10) * math.pi * 2)
                    local offsetX = math.cos(stepAngle) * radius
                    local offsetZ = math.sin(stepAngle) * radius
                    local offsetY = math.sin(stepAngle * 2) * 1.2 

                    block.CFrame = CFrame.new(centerPos + Vector3.new(offsetX, offsetY, offsetZ))

                    local hue = ((i / 10) + (orbitAngle / (math.pi * 2))) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.95, 1)
                    
                    block.Color = rainbowColor
                    if block:FindFirstChild("LEDLight") then block.LEDLight.Color = rainbowColor end
                    if block:FindFirstChild("LightTrail") then block.LightTrail.Color = ColorSequence.new(rainbowColor) end
                end
            end
        else
            if blocksFolder then blocksFolder:Destroy() end
        end

        -- 2. มงกุฎบล็อกจิ๋วบนหัว (Halo Crown)
        local crownFolder = workspace:FindFirstChild("ZzzZ_HaloCrown_" .. LocalPlayer.Name)

        if State.HaloCrownEnabled and head then
            if not crownFolder then
                crownFolder = Instance.new("Folder")
                crownFolder.Name = "ZzzZ_HaloCrown_" .. LocalPlayer.Name
                crownFolder.Parent = workspace

                for i = 1, 10 do
                    local cBlock = Instance.new("Part")
                    cBlock.Name = "CrownBlock_" .. i
                    cBlock.Size = Vector3.new(0.2, 0.25, 0.2)
                    cBlock.Material = Enum.Material.Neon
                    cBlock.Anchored = true
                    cBlock.CanCollide = false
                    cBlock.CanTouch = false
                    cBlock.CanQuery = false
                    cBlock.Parent = crownFolder

                    local cLight = Instance.new("PointLight")
                    cLight.Name = "CrownLight"
                    cLight.Range = 4
                    cLight.Brightness = 2
                    cLight.Parent = cBlock
                end
            end

            local crownCenter = head.Position + Vector3.new(0, 1.2, 0)
            local crownRadius = 0.95

            for i = 1, 10 do
                local cBlock = crownFolder:FindFirstChild("CrownBlock_" .. i)
                if cBlock then
                    local angle = (orbitAngle * 0.8) + ((i / 10) * math.pi * 2)
                    local cx = math.cos(angle) * crownRadius
                    local cz = math.sin(angle) * crownRadius
                    local cy = math.sin(i * 1.5) * 0.1 

                    cBlock.CFrame = CFrame.new(crownCenter + Vector3.new(cx, cy, cz)) * CFrame.Angles(0, -angle, 0)

                    local hue = ((i / 10) + (orbitAngle / (math.pi * 2))) % 1
                    local crownColor = Color3.fromHSV(hue, 0.9, 1)
                    cBlock.Color = crownColor
                    if cBlock:FindFirstChild("CrownLight") then cBlock.CrownLight.Color = crownColor end
                end
            end
        else
            if crownFolder then crownFolder:Destroy() end
        end

        -- 3. ระบบรถแรง & ยืดล้อ
        if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
            local seat = hum.SeatPart
            local car = seat:FindFirstAncestorOfClass("Model") or seat.Parent

            if State.VehicleBoostEnabled then
                seat.MaxSpeed = State.VehicleSpeed
                seat.Torque = State.VehicleSpeed * 10
                if seat.Throttle ~= 0 then
                    seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (seat.Throttle * State.VehicleSpeed)
                end
            end

            if car then
                for _, spring in pairs(car:GetDescendants()) do
                    if spring:IsA("SpringConstraint") then
                        spring.FreeLength = math.max(0.1, State.VehicleSuspension + State.VehicleHeight)
                    end
                end

                local wheels = FindCarWheels(car)
                for _, wheel in ipairs(wheels) do
                    local name = wheel.Name:lower()
                    if name:find("rear") or name:find("back") or name:find("หลัง") or name:find("r") then
                        local isRight = (wheel.Position - seat.Position):Dot(seat.CFrame.RightVector) > 0
                        local extVal = isRight and State.RearWheelExtension or -State.RearWheelExtension

                        for _, joint in pairs(wheel:GetJoints()) do
                            if joint:IsA("Weld") or joint:IsA("Motor6D") then
                                joint.C0 = CFrame.new(extVal, 0, 0)
                            elseif joint:IsA("CylindricalConstraint") or joint:IsA("SpringConstraint") then
                                if joint.Attachment0 then
                                    joint.Attachment0.CFrame = CFrame.new(extVal, 0, 0)
                                end
                            end
                        end
                    end
                end
            end
        end

    end
end)

