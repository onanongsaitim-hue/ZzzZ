-- 3. ระบบ Auto Regen (ปั๊มเลือดอัตโนมัติ)
CreateToggle(HealthTab, "🔄 Auto Heal (10 HP/sec)", false, function(val)
    HealthModState.AutoRegenEnabled = val
end)

task.spawn(function()
    while true do
        task.wait(HealthModState.RegenInterval)
        if HealthModState.AutoRegenEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                local hum = char.Humanoid
                if hum.Health > 0 and hum.Health < hum.MaxHealth then
                    hum.Health = math.min(hum.Health + HealthModState.RegenAmount, hum.MaxHealth)
                end
            end
        end
    end
end)

-- 4. ระบบ God Mode (ล็อคเลือดอมตะ)
CreateToggle(HealthTab, "🛡️️ God Mode (Lock HP)", false, function(val)
    HealthModState.GodModeEnabled = val
end)

RunService.RenderStepped:Connect(function()
    if HealthModState.GodModeEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.Health = char.Humanoid.MaxHealth
        end
    end
end)

