-- ระบบตีเร็ว (ลดคูลดาวน์การโจมตีเหลือ 0.5 วินาที)
task.spawn(function()
    local lastAttack = 0
    while task.wait(0.1) do
        if fastAttackEnabled then
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    if tick() - lastAttack >= 0.5 then
                        lastAttack = tick()
                        tool:Activate()
                    end
                end
            end
        end
    end
end)

-- Dynamic Custom Hitbox Loop
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            
            -- หัว
            local head = char:FindFirstChild("Head")
            if head then
                if headHitboxEnabled then
                    head.Size = Vector3.new(headHitboxSize, headHitboxSize, headHitboxSize)
                    head.Transparency = 0.6
                    head.Color = Color3.fromRGB(0, 170, 255)
                    head.Material = Enum.Material.Neon
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(2, 1, 1)
                    head.Transparency = 0
                    head.Material = Enum.Material.Plastic
                end
            end

            -- ตัว (HumanoidRootPart)
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if bodyHitboxEnabled then
                    hrp.Size = Vector3.new(bodyHitboxSize, bodyHitboxSize, bodyHitboxSize)
                    hrp.Transparency = 0.7
                    hrp.Color = Color3.fromRGB(0, 255, 120)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end
end)
