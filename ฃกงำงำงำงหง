-- 3. ระบบเอฟเฟกต์การวิ่ง, เงาสายรุ้ง และกริต
-- ==========================================
local currentLevel = 0
local originalNeckC0 = nil
local activeClones = 0
local MAX_CLONES = 25

-- เอฟเฟกต์โลกเทา
local colorCorrection = Lighting:FindFirstChild("CyberpunkCC") or Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "CyberpunkCC"
colorCorrection.Parent = Lighting
colorCorrection.Enabled = false
colorCorrection.Saturation = -1

local cloneFolder = workspace:FindFirstChild("CyberpunkClones") or Instance.new("Folder")
cloneFolder.Name = "CyberpunkClones"
cloneFolder.Parent = workspace

local function getNeck(char)
	local neck = char:FindFirstChild("Neck", true)
	if neck and not originalNeckC0 then
		originalNeckC0 = neck.C0
	end
	return neck
end

local function resetCharVisuals()
	local char = player.Character
	if not char then return end
	local neck = getNeck(char)
	if neck and originalNeckC0 then
		neck.C0 = originalNeckC0
	end
	local hl = char:FindFirstChild("GlitchHighlight")
	if hl then hl:Destroy() end
end

local function updateButtons(lvl)
	local list = {
		{btn = btnLvl1, s = stroke1, id = 1},
		{btn = btnLvl2, s = stroke2, id = 2},
		{btn = btnLvl3, s = stroke3, id = 3},
	}
	for _, item in ipairs(list) do
		if item.id == lvl then
			item.btn.BackgroundColor3 = Color3.fromRGB(0, 60, 45)
			item.s.Thickness = 2
		else
			item.btn.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
			item.s.Thickness = 1
		end
	end
end

local function setLevel(lvl)
	currentLevel = lvl
	updateButtons(lvl)
	resetCharVisuals()

	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if lvl == 0 then
		hum.WalkSpeed = 16
		colorCorrection.Enabled = false
	elseif lvl == 1 then
		hum.WalkSpeed = 100
		colorCorrection.Enabled = true
	elseif lvl == 2 then
		hum.WalkSpeed = 200
		colorCorrection.Enabled = true
	elseif lvl == 3 then
		hum.WalkSpeed = 800
		colorCorrection.Enabled = true
	end
end

