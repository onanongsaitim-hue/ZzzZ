local hueTimer = 0.33
local lastClone = 0

RunService.RenderStepped:Connect(function(dt)
	if currentLevel <= 0 then return end

	-- วนลูปสีสายรุ้ง (เริ่มจากสีเขียว)
	hueTimer = (hueTimer + dt * 1.5) % 1
	floatGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(hueTimer, 1, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hueTimer + 0.5) % 1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(hueTimer, 1, 1))
	})

	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart

	-- สร้างเงาสายรุ้งตามตัว
	local interval = (currentLevel == 3) and 0.08 or 0.15
	if root.AssemblyLinearVelocity.Magnitude > 15 and (tick() - lastClone > interval) and activeClones < MAX_CLONES then
		lastClone = tick()
		activeClones += 1

		local cloneColor = Color3.fromHSV(hueTimer, 1, 1)
		char.Archivable = true
		local clone = char:Clone()
		char.Archivable = false

		local parts = {}
		for _, obj in ipairs(clone:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.Anchored = true
				obj.CanCollide = false
				obj.Material = Enum.Material.Neon
				obj.Color = cloneColor
				obj.Transparency = 0.35
				table.insert(parts, obj)
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj.Transparency = 0.5
				table.insert(parts, obj)
			elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Humanoid") or obj:IsA("Sound") then
				obj:Destroy()
			end
		end
		clone.Parent = cloneFolder

		-- เวล 3 ค้าง 2 วินาที / เวล 1-2 ค้าง 0.5 วินาที
		local hold = (currentLevel == 3) and 2 or 0.5
		task.delay(hold, function()
			if clone and clone.Parent then
				for _, p in ipairs(parts) do
					if p and p.Parent then
						TweenService:Create(p, TweenInfo.new(0.4), {Transparency = 1}):Play()
					end
				end
				task.wait(0.4)
				if clone then clone:Destroy() end
			end
			activeClones = math.max(0, activeClones - 1)
		end)
	end

	-- เอฟเฟกต์กริต (Glitch)
	local neck = getNeck(char)
	if currentLevel == 2 and neck then
		local rx = math.rad(math.random(-15, 15))
		local ry = math.rad(math.random(-20, 20))
		neck.C0 = originalNeckC0 * CFrame.Angles(rx, ry, 0)
	elseif currentLevel == 3 and neck then
		local rx = math.rad(math.random(-40, 40))
		local ry = math.rad(math.random(-50, 50))
		local rz = math.rad(math.random(-30, 30))
		neck.C0 = originalNeckC0 * CFrame.Angles(rx, ry, rz)

		local hl = char:FindFirstChild("GlitchHighlight") or Instance.new("Highlight")
		hl.Name = "GlitchHighlight"
		hl.Adornee = char
		hl.FillColor = Color3.fromHSV(hueTimer, 1, 1)
		hl.OutlineColor = Color3.fromRGB(0, 255, 128)
		hl.FillTransparency = (math.random() > 0.4) and 0.4 or 0.8
		hl.OutlineTransparency = 0
		hl.Parent = char
	end
end)
