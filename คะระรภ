-- 2. ฟังก์ชันเอฟเฟกต์แฟลชแบ็ก ("ฟึบ!")
-- ==========================================
local function playFlashbackEffect(callback)
	flashScreen.BackgroundTransparency = 0.2
	TweenService:Create(flashScreen, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
	if callback then callback() end
end

