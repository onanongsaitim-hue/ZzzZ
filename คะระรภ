-- 3. สร้างโมเดลบล็อกสี่เหลี่ยม (โดรน)
-- ==========================================
local function createDroneModel(cframe)
	local model = Instance.new("Model")
	model.Name = "SquareDrone"

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.new(2, 0.8, 2)
	core.Color = Color3.fromRGB(35, 35, 40)
	core.Material = Enum.Material.Neon
	core.CFrame = cframe
	core.CanCollide = true
	core.Parent = model
	model.PrimaryPart = core

	-- ไฟสถานะสีเขียวแฮ็กเกอร์รอบโดรน
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(50, 255, 100)
	light.Brightness = 2
	light.Range = 8
	light.Parent = core

	model.Parent = workspace
	return model
end

