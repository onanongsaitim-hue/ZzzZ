-- 4. ฟังก์ชันควบคุมการบินโดรน
-- ==========================================
local moveUp = false
local moveDown = false

btnUp.MouseButton1Down:Connect(function() moveUp = true end)
btnUp.MouseButton1Up:Connect(function() moveUp = false end)
btnDown.MouseButton1Down:Connect(function() moveDown = true end)
btnDown.MouseButton1Up:Connect(function() moveDown = false end)

local function startDroneControl()
	if not deployedDrone or not deployedDrone.PrimaryPart then return end
	isControlling = true
	hackerGui.Enabled = true
	camera.CameraType = Enum.CameraType.Scriptable

	playFlashbackEffect()

	local dronePart = deployedDrone.PrimaryPart
	local currentPos = dronePart.Position
	local currentYaw = 0
	local speed = 35

	droneConnection = RunService.RenderStepped:Connect(function(dt)
		if not deployedDrone or not deployedDrone.Parent then
			stopDroneControl()
			return
		end

		local char = player.Character
		local moveDir = char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.MoveDirection or Vector3.new(0,0,0)

		-- คำนวณทิศทางการเลี้ยวตามการเดินหรือปุ่ม
		if moveDir.Magnitude > 0 then
			local camLook = camera.CFrame.LookVector
			local steer = moveDir.X
			currentYaw = currentYaw - (steer * 2.5 * dt)
		end

		local upDownInput = 0
		if moveUp then upDownInput = 1 end
		if moveDown then upDownInput = -1 end

		local rotCF = CFrame.Angles(0, currentYaw, 0)
		local forwardVec = rotCF.LookVector

		currentPos = currentPos + (forwardVec * speed * dt) + Vector3.new(0, upDownInput * speed * dt, 0)
		
		local targetCF = CFrame.new(currentPos) * rotCF
		deployedDrone:SetPrimaryPartCFrame(targetCF)

		-- มุมมองบุคคลที่หนึ่งติดอยู่ที่ตัวโดรนเป๊ะ ๆ
		camera.CFrame = targetCF * CFrame.new(0, 0.4, 0)
	end)
end

function stopDroneControl()
	if not isControlling then return end
	isControlling = false
	hackerGui.Enabled = false

	if droneConnection then
		droneConnection:Disconnect()
		droneConnection = nil
	end

	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- ==========================================
-- 5. สร้างไอเทมชิ้นที่ 1: โดรน (Deploy Drone Tool)
-- ==========================================
local function createDeployTool()
	local tool = Instance.new("Tool")
	tool.Name = "Deploy Drone"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1.2, 0.6, 1.2)
	handle.Color = Color3.fromRGB(40, 40, 45)
	handle.Material = Enum.Material.Metal
	handle.Parent = tool

	tool.Activated:Connect(function()
		local char = player.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return end
		local root = char.HumanoidRootPart

		if deployedDrone then deployedDrone:Destroy() end
		
		-- วางโดรนไว้ข้างหน้าผู้เล่น
		local spawnCF = root.CFrame * CFrame.new(0, 0, -5) + Vector3.new(0, 2, 0)
		deployedDrone = createDroneModel(spawnCF)
	end)

	tool.Parent = player:WaitForChild("Backpack")
	droneTool = tool
end

-- ==========================================
-- 6. สร้างไอเทมชิ้นที่ 2: รีโมท (Remote Control Tool)
-- ==========================================
local function createRemoteTool()
	local tool = Instance.new("Tool")
	tool.Name = "Drone Remote"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.6, 0.2, 1.0)
	handle.Color = Color3.fromRGB(200, 50, 50)
	handle.Material = Enum.Material.SmoothPlastic
	handle.Parent = tool

	tool.Equipped:Connect(function()
		if deployedDrone then
			startDroneControl()
		else
			-- แจ้งเตือนหรือให้วางโดรนก่อน
			print("ยังไม่ได้วางโดรน!")
		end
	end)

	tool.Unequipped:Connect(function()
		stopDroneControl()
	end)

	tool.Parent = player:WaitForChild("Backpack")
	remoteTool = tool
end

