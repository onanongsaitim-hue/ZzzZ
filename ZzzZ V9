-- สร้างตัวโมเดล "ดาบใหญ่นักรบมังกร" ลอยล้อมรอบ
local function createDragonGreatsword(index)
    local sword = Instance.new("Model")
    sword.Name = "DragonGreatsword_" .. tostring(index)

    -- ใบดาบขนาดใหญ่
    local blade = Instance.new("Part")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.6, 9, 1.8)
    blade.Material = Enum.Material.Neon
    blade.Color = Color3.fromRGB(255, 120, 0) -- ส้มมังกร
    blade.CanCollide = false
    blade.Anchored = true
    blade.Parent = sword

    -- สันดาบหนาแบบศิลาโบราณ
    local spine = Instance.new("Part")
    spine.Name = "Spine"
    spine.Size = Vector3.new(0.8, 8.5, 0.6)
    spine.Material = Enum.Material.Granite
    spine.Color = Color3.fromRGB(40, 40, 40)
    spine.CanCollide = false
    spine.Anchored = true
    spine.Parent = sword

    -- ประกายออร่ามังกร
    local selectionBox = Instance.new("SelectionBox")
    selectionBox.Color3 = Color3.fromRGB(255, 200, 0)
    selectionBox.Adornee = blade
    selectionBox.LineThickness = 0.05
    selectionBox.Parent = blade

    sword.PrimaryPart = blade
    return sword
end

local function spawnDragonSwords()
    -- ลบดาบเก่าออกก่อน
    for _, sw in pairs(dragonSwordsTable) do
        if sw then sw:Destroy() end
    end
    dragonSwordsTable = {}

    if swordRingEnabled then
        local folder = workspace:FindFirstChild("ZzzZ_DragonSwords_World")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "ZzzZ_DragonSwords_World"
            folder.Parent = workspace
        end

        for i = 1, 10 do
            local sw = createDragonGreatsword(i)
            sw.Parent = folder
            table.insert(dragonSwordsTable, sw)
        end
        skillContainer.Visible = true
    else
        local folder = workspace:FindFirstChild("ZzzZ_DragonSwords_World")
        if folder then folder:Destroy() end
        skillContainer.Visible = false
    end
end

ringToggleBtn.MouseButton1Click:Connect(function()
