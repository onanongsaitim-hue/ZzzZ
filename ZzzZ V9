-- ⚔️ SKILL 1 ACTION (คลื่นฟันพลังมังกร)
-- ========================================================
skill1Btn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    if not torso then return end

    isPerformingSpecial = true

    -- สร้างคลื่นพลังดาบมังกรขนาดใหญ่พุ่งไปข้างหน้า
    local wave = Instance.new("Part")
    wave.Size = Vector3.new(12, 0.5, 12)
    wave.Material = Enum.Material.Neon
    wave.Color = Color3.fromRGB(255, 100, 0)
    wave.CFrame = torso.CFrame * CFrame.new(0, 0, -5) * CFrame.Angles(0, 0, math.rad(45))
    wave.CanCollide = false
    wave.Parent = workspace
    
    wave.Touched:Connect(function(hit)
        local hitModel = hit.Parent
        if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
            sendToSpace(hitModel)
        end
    end)

    TweenService:Create(wave, TweenInfo.new(0.4), {Size = Vector3.new(25, 0.2, 25), Transparency = 1, CFrame = wave.CFrame * CFrame.new(0, 0, -45)}):Play()
    game:GetService("Debris"):AddItem(wave, 0.45)

    task.wait(0.3)
    isPerformingSpecial = false
end)

-- ========================================================
-- 🌀 SKILL 2 ACTION (ยกมือ -> ค่อยๆ หันคมดาบทีละเล่ม -> พุ่งส่งออกนอกโลก!)
-- ========================================================
skill2Btn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial or #dragonSwordsTable < 10 then return end
    local char = LocalPlayer.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    local rightArm = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
    if not torso or not rightArm then return end

    isPerformingSpecial = true

    -- 1. ชูมือขึ้นฟ้า
    local rShoulder = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder")
    local origC0 = rShoulder and rShoulder.C0 or CFrame.new()

    if rShoulder then
        TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0 * CFrame.Angles(math.rad(170), 0, 0)}):Play()
    end
    task.wait(0.3)

    -- 2. ค่อยๆ หันปลายคมดาบทีละเล่มเข้าหาทิศทางที่ผู้เล่นมองอยู่ (ฟึบ... ฟึบ... ฟึบ...)
    local forwardCF = torso.CFrame

    for i, sw in ipairs(dragonSwordsTable) do
        local blade = sw.PrimaryPart
        if blade then
            -- คํานวณตำแหน่งเรียงแถวหน้ากระดานกลางอากาศเตรียมพุ่ง
            local targetPos = forwardCF * CFrame.new((i - 5.5) * 3, 4, -8)
            -- หันปลายแหลมลงหาศัตรูข้างหน้า
            local aimCF = CFrame.lookAt(targetPos.Position, forwardCF * CFrame.new(0, 0, -50).Position) * CFrame.Angles(math.rad(-90), 0, 0)

            TweenService:Create(blade, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = aimCF}):Play()
            task.wait(0.08) -- จังหวะทยอยหันทีละเล่ม
        end
    end

    task.wait(0.3)

    -- 3. ยิงพุ่งออกไปทีละเล่มด้วยความเร็วสูง!
    for i, sw in ipairs(dragonSwordsTable) do
        local blade = sw.PrimaryPart
        if blade then
            local endCF = blade.CFrame * CFrame.new(0, 120, 0) -- พุ่งตรงไปข้างหน้ามหาศาล

            -- ตรวจจับผู้เล่นที่โดนดาบเล่มนี้ชน
            local touchConn
            touchConn = blade.Touched:Connect(function(hit)
                local hitModel = hit.Parent
                if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
                    sendToSpace(hitModel)
                end
            end)

            TweenService:Create(blade, TweenInfo.new(0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {CFrame = endCF}):Play()
            
            task.delay(0.3, function()
                if touchConn then touchConn:Disconnect() end
            end)
            
            task.wait(0.07) -- ทยอยพุ่งทีละเล่มอย่างต่อเนื่อง
        end
    end

    task.wait(0.6)

    -- เอาแขนกลับท่าเดิม
    if rShoulder then
        TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0}):Play()
    end

    isPerformingSpecial = false
end)

-- Loop อัปเดตตำแหน่งดาบลอยล้อมรอบตัวผู้เล่น (เมื่อไม่ได้ใช้สกิล)
RunService.RenderStepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    if char and swordRingEnabled and not isPerformingSpecial and #dragonSwordsTable > 0 then
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then
            swordAngle = (swordAngle + (60 * deltaTime)) % 360

            for i, sw in ipairs(dragonSwordsTable) do
                local blade = sw.PrimaryPart
                if blade then
                    local offsetRad = math.rad(swordAngle + (i * 36))
                    local radius = 8
                    local x = math.cos(offsetRad) * radius
                    local z = math.sin(offsetRad) * radius

                    -- ลอยล้อมรอบตัวแบบแนวตั้งอิสระ
                    local targetCFrame = torso.CFrame * CFrame.new(x, 2 + math.sin(tick() * 2 + i) * 0.5, z) * CFrame.Angles(0, -offsetRad, math.rad(15))
                    blade.CFrame = blade.CFrame:Lerp(targetCFrame, 0.2)
                end
            end
        end
    end
end)
