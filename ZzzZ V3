-- UI Helper Functions
local function createButton(text, position)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.Position = position
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = mainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(60, 60, 75)
    stroke.Parent = btn

    return btn
end

local function createTextBox(placeholder, position)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.9, 0, 0, 32)
    box.Position = position
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    box.PlaceholderText = placeholder
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
    box.TextSize = 13
    box.Font = Enum.Font.SourceSans
    box.Parent = mainFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = box

    return box
end

-- Controls Creation
local headToggleBtn = createButton("🎯 Hitbox หัว: [ OFF ]", UDim2.new(0.05, 0, 0.13, 0))
local headInputBox  = createTextBox("ขนาด Hitbox หัว (ปกติ: 1.2)", UDim2.new(0.05, 0, 0.24, 0))

local bodyToggleBtn = createButton("🛡️ Hitbox ตัว: [ OFF ]", UDim2.new(0.05, 0, 0.36, 0))
local bodyInputBox  = createTextBox("ขนาด Hitbox ตัว (ปกติ: 2.0)", UDim2.new(0.05, 0, 0.47, 0))

local fpsToggleBtn  = createButton("⚡ Boost FPS (ลดเอฟเฟกต์): [ OFF ]", UDim2.new(0.05, 0, 0.62, 0))

-- Event Handlers for Inputs
headInputBox.FocusLost:Connect(function()
    local val = tonumber(headInputBox.Text)
    if val then headSize = val end
end)

bodyInputBox.FocusLost:Connect(function()
    local val = tonumber(bodyInputBox.Text)
    if val then bodySize = val end
end)

-- Button Toggle Actions
headToggleBtn.MouseButton1Click:Connect(function()
    headHitboxEnabled = not headHitboxEnabled
    if headHitboxEnabled then
        headToggleBtn.Text = "🎯 Hitbox หัว: [ ON ]"
        headToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 75)
    else
        headToggleBtn.Text = "🎯 Hitbox หัว: [ OFF ]"
        headToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end
end)

bodyToggleBtn.MouseButton1Click:Connect(function()
    bodyHitboxEnabled = not bodyHitboxEnabled
    if bodyHitboxEnabled then
        bodyToggleBtn.Text = "🛡️ Hitbox ตัว: [ ON ]"
        bodyToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 75)
    else
        bodyToggleBtn.Text = "🛡️ Hitbox ตัว: [ OFF ]"
        bodyToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end
end)

fpsToggleBtn.MouseButton1Click:Connect(function()
    fpsBoostEnabled = not fpsBoostEnabled
    if fpsBoostEnabled then
        fpsToggleBtn.Text = "⚡ Boost FPS (ลดเอฟเฟกต์): [ ON ]"
        fpsToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 70, 50)

        if setfpscap then setfpscap(30) end
        Lighting.GlobalShadows = false

        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Trail") then
                obj.Enabled = false
            end
        end
    else
        fpsToggleBtn.Text = "⚡ Boost FPS (ลดเอฟเฟกต์): [ OFF ]"
        fpsToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)

        if setfpscap then setfpscap(60) end
        Lighting.GlobalShadows = true
    end
end)

-- Hitbox Application Loop
RunService.RenderStepped:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")

            -- Head Hitbox Update
            if head then
                if headHitboxEnabled then
                    head.Size = Vector3.new(headSize, headSize, headSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            -- Body Hitbox Update
            if torso then
                if bodyHitboxEnabled then
                    torso.Size = Vector3.new(bodySize, bodySize, bodySize)
                    torso.Transparency = 0.5
                    torso.CanCollide = false
                else
                    torso.Size = Vector3.new(2, 2, 1)
                    torso.Transparency = 0
                end
            end
        end
    end
end)
