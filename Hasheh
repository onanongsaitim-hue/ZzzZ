local function getBestTargetByCrosshair()
    local camera = Workspace.CurrentCamera
    local targetScreenCenter = Vector2.new(camera.ViewportSize.X / 2, (camera.ViewportSize.Y / 2) + crosshairOffsetY)
    local bestTarget = nil
    local lowestScore = math.huge

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetChar = player.Character
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

            if targetHrp and targetHum and targetHum.Health > 0 then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetHrp.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - targetScreenCenter).Magnitude
                    local worldDist = myRoot and (targetHrp.Position - myRoot.Position).Magnitude or 100
                    local totalScore = screenDist + (worldDist * 1.5)

                    if totalScore < lowestScore then
                        lowestScore = totalScore
                        bestTarget = targetChar
                    end
                end
            end
        end
    end
    return bestTarget
end

