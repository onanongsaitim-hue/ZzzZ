        setGlobalUILockState(false)
    else
        local target = getBestTargetByCrosshair()
        if target then
            currentTarget = target
            skillActionButton.Text = "🔒 ล็อคอยู่: " .. target.Name
            skillActionButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            setGlobalUILockState(true)
        end
    end
end)

