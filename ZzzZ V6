-- SPECIAL ATTACK 1: หยิบดาบมาฟัน
-- --------------------------------------------------------
slashAttackBtn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    if not char then return end

    local rightArm = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local folder = char:FindFirstChild("ZzzZ_10Swords")
    if not folder or not rightArm or not torso then return end

    isPerformingSpecial = true

    -- ดึงดาบเล่มที่ 1 ลงมาถือที่มือขวา
    local sword1 = folder:FindFirstChild("AwesomeSword_1")
    local motor1 = torso:FindFirstChild("SwordMotor_1")
    if sword1 and motor1 then
        motor1.Part0 = rightArm
        motor1.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        motor1.C1 = CFrame.new(0, 0, 0)

        -- ท่าฟันดาบแบบ CFrame Tweening
        local rShoulder = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder")
        local origC0 = rShoulder and rShoulder.C0 or CFrame.new()

        if rShoulder then
            -- ง้างแขนขึ้น
            TweenService:Create(rShoulder, TweenInfo.new(0.2), {C0 = origC0 * CFrame.Angles(math.rad(120), 0, math.rad(30))}):Play()
            task.wait(0.25)

            -- ฟันลงอย่างรวดเร็ว
            TweenService:Create(rShoulder, TweenInfo.new(0.15), {C0 = origC0 * CFrame.Angles(math.rad(-40), math.rad(-50), math.rad(-20))}):Play()
            
            -- สร้างคลื่นดาบฟาด
            local wave = Instance.new("Part")
            wave.Size = Vector3.new(6, 0.2, 6)
            wave.Material = Enum.Material.Neon
            wave.Color = Color3.fromRGB(0, 255, 255)
            wave.CFrame = torso.CFrame * CFrame.new(0, 0, -4) * CFrame.Angles(0, 0, math.rad(45))
            wave.CanCollide = false
            wave.Parent = workspace
            
            TweenService:Create(wave, TweenInfo.new(0.3), {Size = Vector3.new(12, 0.1, 12), Transparency = 1}):Play()
            game:GetService("Debris"):AddItem(wave, 0.3)

            task.wait(0.3)
            -- คืนค่าแขน
            TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0}):Play()
        end

        -- ส่งดาบกลับเข้าวงแหวน
        motor1.Part0 = torso
    end

    isPerformingSpecial = false
end)

-- --------------------------------------------------------
-- SPECIAL ATTACK 2: ชูมือชี้ฟ้ากงจักรดาบพุ่ง
-- --------------------------------------------------------
shurikenBtn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    if not char then return end

    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local rightArm = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local folder = char:FindFirstChild("ZzzZ_10Swords")
    if not folder or not torso or not rightArm then return end

    isPerformingSpecial = true

    -- 1. เล่นท่าชูมือขึ้นฟ้า แล้วชี้ไปข้างหน้า
    local rShoulder = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder")
    local origC0 = rShoulder and rShoulder.C0 or CFrame.new()

    if rShoulder then
        -- ชูมือขึ้นฟ้า
        TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0 * CFrame.Angles(math.rad(160), 0, 0)}):Play()
        task.wait(0.35)
        -- ชี้ไปข้างหน้า!
        TweenService:Create(rShoulder, TweenInfo.new(0.2), {C0 = origC0 * CFrame.Angles(math.rad(90), 0, 0)}):Play()
    end

    -- 2. ดาบทั้ง 10 เล่มบีบรวมเป็นกงจักร และหมุนสปีดสูง
    swordSpinSpeed = 1200 -- หมุนเร็วจัด
    local launchDistance = 45
    local forwardCF = torso.CFrame.LookVector * launchDistance

    -- พุ่งออกไปข้างหน้า
    for step = 1, 20 do
        swordRingRadius = math.clamp(swordRingRadius - 0.15, 1.2, 4.5) -- บีบวงแน่นขึ้น
        task.wait(0.015)
    end

    -- ย้ายตำแหน่งกงจักรพุ่งออกไป
    for i = 1, 10 do
        local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
        if motor then
            TweenService:Create(motor, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                C0 = CFrame.new(forwardCF + Vector3.new(0, 1, 0))
            }):Play()
        end
    end

    task.wait(0.6)

    -- กงจักรพุ่งย้อนกลับเข้าหาตัว
    for i = 1, 10 do
        local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
        if motor then
            TweenService:Create(motor, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                C0 = CFrame.new(0, 0.5, 1.2)
            }):Play()
        end
    end

    task.wait(0.5)

    -- คืนค่าเดิม
    swordRingRadius = 4.5
    swordSpinSpeed = 120
    if rShoulder then
        TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0}):Play()
    end

    isPerformingSpecial = false
end)

