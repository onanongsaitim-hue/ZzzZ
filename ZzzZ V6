        giantToggleBtn.Text = "🗿 แปลงร่างเป็นร่างยักษ์: [ ON ]"
        giantToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 75)
        if hum then
            if hum:FindFirstChild("BodyHeightScale") then hum.BodyHeightScale.Value = 2.5 end
            if hum:FindFirstChild("BodyWidthScale") then hum.BodyWidthScale.Value = 2.5 end
            if hum:FindFirstChild("HeadScale") then hum.HeadScale.Value = 2.5 end
        end
    else
        giantToggleBtn.Text = "🗿 แปลงร่างเป็นร่างยักษ์: [ OFF ]"
        giantToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        if hum then
            if hum:FindFirstChild("BodyHeightScale") then hum.BodyHeightScale.Value = 1 end
            if hum:FindFirstChild("BodyWidthScale") then hum.BodyWidthScale.Value = 1 end
            if hum:FindFirstChild("HeadScale") then hum.HeadScale.Value = 1 end
        end
    end
end)

-- Auto Re-apply on Spawn
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart")
    task.wait(1)
    if swordRingEnabled then spawn10Swords(char) end
end)

-- Render Loop: Smooth 10 Swords Rotation & Hitbox Expansion
RunService.RenderStepped:Connect(function(deltaTime)
    -- 1. Render 10 Swords Spinning
    if swordRingEnabled and LocalPlayer.Character then
        local torso = LocalPlayer.Character:FindFirstChild("UpperTorso") or LocalPlayer.Character:FindFirstChild("Torso")
        if torso then
            swordAngle = (swordAngle + (swordSpinSpeed * deltaTime)) % 360

            for i = 1, 10 do
                local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
                if motor and not (isPerformingSpecial and i == 1 and motor.Part0 ~= torso) then
                    local offsetRad = math.rad(swordAngle + (i * 36))
                    local x = math.cos(offsetRad) * swordRingRadius
                    local y = math.sin(offsetRad) * swordRingRadius

                    if not isPerformingSpecial then
                        motor.C0 = CFrame.new(x, y, 1.2) * CFrame.Angles(0, 0, offsetRad + math.rad(90))
                    else
                        motor.C1 = CFrame.Angles(0, 0, offsetRad + math.rad(90))
                    end
                end
            end
        end
    end

    -- 2. Hitbox Expansion Loop
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")

            if head then
                if headHitboxEnabled then
                    head.Size = Vector3.new(headSize, headSize, headSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            if torso then
                if bodyHitboxEnabled then
                    torso.Size = Vector3.new(bodySize, bodySize, bodySize)
                    torso.Transparency = 0.5
                    torso.CanCollide = false
                else
                    torso.Size = Vector3.new(2, 2, 1)
                    torso.Transparency = 0
                end
            end
        end
    end
end)
