-- RENDER LOOP
---------------------------------------------------------
local orbitAngle = 0
local wheelAngle = 0

RunService.RenderStepped:Connect(function()
    orbitAngle = (orbitAngle + 0.04) % (math.pi * 2)
    wheelAngle = (wheelAngle + (0.02 * State.LegWheelSpeed)) % (math.pi * 2)

    -- Noclip
    if State.NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- Hitbox Adjustment
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                if State.HeadHitboxEnabled then
                    head.Size = Vector3.new(State.HeadSize, State.HeadSize, State.HeadSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            if plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if State.BodyHitboxEnabled then
                    hrp.Size = Vector3.new(State.BodySize, State.BodySize, State.BodySize)
                    hrp.Transparency = 0.6
                    hrp.Color = Color3.fromRGB(255, 0, 0)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end

    -- WalkSpeed
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if State.SpeedHackEnabled then
            hum.WalkSpeed = State.WalkSpeedValue
        end
    end

    -- Lighting
    if State.FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    Lighting.ClockTime = State.TimeOfDay

    -- Vehicle & Visual Effects
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart
        local head = char:FindFirstChild("Head")

        -----------------------------------------------------
        -- 1. บล็อกไฟตั้งหมุนเกลียวเลื้อย (หลังตัวละคร)
        -----------------------------------------------------
        local blocksFolder = workspace:FindFirstChild("ZzzZ_SpiralLED_" .. LocalPlayer.Name)

        if State.BackLEDEnabled then
            if not blocksFolder then
                blocksFolder = Instance.new("Folder")
                blocksFolder.Name = "ZzzZ_SpiralLED_" .. LocalPlayer.Name
                blocksFolder.Parent = workspace

                for i = 1, 12 do
                    local block = Instance.new("Part")
                    block.Name = "SpiralBlock_" .. i
                    block.Size = Vector3.new(0.3, 0.3, 0.3)
                    block.Material = Enum.Material.Neon
                    block.Anchored = true
                    block.CanCollide = false
                    block.CanTouch = false
                    block.CanQuery = false
                    block.Parent = blocksFolder

                    local light = Instance.new("PointLight")
                    light.Name = "LEDLight"
                    light.Range = 8
                    light.Brightness = 4
                    light.Parent = block

                    local att0 = Instance.new("Attachment", block)
                    att0.Position = Vector3.new(0, 0.2, 0)
                    local att1 = Instance.new("Attachment", block)
                    att1.Position = Vector3.new(0, -0.2, 0)

                    local trail = Instance.new("Trail")
                    trail.Name = "LightTrail"
                    trail.Attachment0 = att0
                    trail.Attachment1 = att1
                    trail.Lifetime = 0.4
                    trail.MinLength = 0.1
                    trail.FaceCamera = true
                    trail.LightEmission = 1
                    trail.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    trail.Parent = block
                end
            end

            local backPos = hrp.Position - (hrp.CFrame.LookVector * 1.5)
            local radius = 1.8

            for i = 1, 12 do
                local block = blocksFolder:FindFirstChild("SpiralBlock_" .. i)
                if block then
                    local stepAngle = orbitAngle + ((i / 12) * math.pi * 2)
                    local offsetX = math.cos(stepAngle) * radius
                    local offsetZ = math.sin(stepAngle) * radius
                    local offsetY = ((i / 12) * 5) - 1.5

                    block.CFrame = CFrame.new(backPos + Vector3.new(offsetX, offsetY, offsetZ))

                    local hue = ((i / 12) + (orbitAngle / (math.pi * 2))) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.95, 1)
                    
                    block.Color = rainbowColor
                    if block:FindFirstChild("LEDLight") then block.LEDLight.Color = rainbowColor end
                    if block:FindFirstChild("LightTrail") then block.LightTrail.Color = ColorSequence.new(rainbowColor) end
                end
            end
        else
            if blocksFolder then blocksFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 2. มงกุฎพระราชาประดับไฟ (King's Crown LED)
        -----------------------------------------------------
        local crownFolder = workspace:FindFirstChild("ZzzZ_KingCrown_" .. LocalPlayer.Name)

        if State.HaloCrownEnabled and head then
            if not crownFolder then
                crownFolder = Instance.new("Folder")
                crownFolder.Name = "ZzzZ_KingCrown_" .. LocalPlayer.Name
                crownFolder.Parent = workspace

                -- สร้าง 8 บล็อกเป็นวงแหวนฐาน + 5 บล็อกเป็นยอดมงกุฎ
                for i = 1, 13 do
                    local cBlock = Instance.new("Part")
                    cBlock.Name = "CrownPart_" .. i
                    cBlock.Size = (i <= 8) and Vector3.new(0.2, 0.2, 0.2) or Vector3.new(0.25, 0.35, 0.25)
                    cBlock.Material = Enum.Material.Neon
                    cBlock.Anchored = true
                    cBlock.CanCollide = false
                    cBlock.CanTouch = false
                    cBlock.CanQuery = false
                    cBlock.Parent = crownFolder

                    local cLight = Instance.new("PointLight")
                    cLight.Name = "CrownLight"
                    cLight.Range = 5
                    cLight.Brightness = 3
                    cLight.Parent = cBlock
                end
            end

            local crownCenter = head.Position + Vector3.new(0, 1.1, 0)
            local baseRadius = 0.85

            for i = 1, 13 do
                local cBlock = crownFolder:FindFirstChild("CrownPart_" .. i)
                if cBlock then
                    local hue = ((i / 13) + (orbitAngle / (math.pi * 2))) % 1
                    local crownColor = Color3.fromHSV(hue, 0.9, 1)

                    if i <= 8 then
                        -- ฐานมงกุฎ
                        local angle = ((i / 8) * math.pi * 2) + (orbitAngle * 0.3)
                        local cx = math.cos(angle) * baseRadius
                        local cz = math.sin(angle) * baseRadius
                        cBlock.CFrame = CFrame.new(crownCenter + Vector3.new(cx, 0, cz))
                    else
                        -- ยอดมงกุฎแหลมชี้ขึ้นฟ้า
                        local peakIndex = i - 8
                        local angle = ((peakIndex / 5) * math.pi * 2) + (orbitAngle * 0.3)
                        local cx = math.cos(angle) * (baseRadius * 0.9)
                        local cz = math.sin(angle) * (baseRadius * 0.9)
                        cBlock.CFrame = CFrame.new(crownCenter + Vector3.new(cx, 0.4, cz)) * CFrame.Angles(0, 0, math.rad(15))
                    end

                    cBlock.Color = crownColor
                    if cBlock:FindFirstChild("CrownLight") then cBlock.CrownLight.Color = crownColor end
                end
            end
        else
            if crownFolder then crownFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 3. วงล้อไฟ LED ข้างเท้าทั้ง 2 ข้าง + แสง Aura พุ่ง (Dual Wheels)
        -----------------------------------------------------
        local dualWheelFolder = workspace:FindFirstChild("ZzzZ_DualFootWheels_" .. LocalPlayer.Name)

        if State.LegWheelLEDEnabled then
            if not dualWheelFolder then
                dualWheelFolder = Instance.new("Folder")
                dualWheelFolder.Name = "ZzzZ_DualFootWheels_" .. LocalPlayer.Name
                dualWheelFolder.Parent = workspace

                -- สร้างวงล้อซ้าย (8 บล็อก) และ วงล้อขวา (8 บล็อก) รวม 16 บล็อก
                for i = 1, 16 do
                    local wBlock = Instance.new("Part")
                    wBlock.Name = "DualBlock_" .. i
                    wBlock.Size = Vector3.new(0.2, 0.2, 0.2)
                    wBlock.Material = Enum.Material.Neon
                    wBlock.Anchored = true
                    wBlock.CanCollide = false
                    wBlock.CanTouch = false
                    wBlock.CanQuery = false
                    wBlock.Parent = dualWheelFolder

                    local wLight = Instance.new("PointLight")
                    wLight.Name = "AuraLight"
                    wLight.Range = 6
                    wLight.Brightness = 5
                    wLight.Parent = wBlock

                    local att0 = Instance.new("Attachment", wBlock)
                    att0.Position = Vector3.new(0, 0.15, 0)
                    local att1 = Instance.new("Attachment", wBlock)
                    att1.Position = Vector3.new(0, -0.15, 0)

                    local trail = Instance.new("Trail")
                    trail.Name = "AuraTrail"
                    trail.Attachment0 = att0
                    trail.Attachment1 = att1
                    trail.Lifetime = 0.35
                    trail.FaceCamera = true
                    trail.LightEmission = 1
                    trail.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.1),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    trail.Parent = wBlock
                end
            end

            local wheelRadius = 1.1
            local rightOffset = hrp.CFrame.RightVector * 1.6
            local leftOffset = -hrp.CFrame.RightVector * 1.6
            local feetY = hrp.Position - Vector3.new(0, 2.5, 0)

            for i = 1, 16 do
                local wBlock = dualWheelFolder:FindFirstChild("DualBlock_" .. i)
                if wBlock then
                    local isLeft = (i <= 8)
                    local indexInWheel = isLeft and i or (i - 8)
                    local sideCenter = feetY + (isLeft and leftOffset or rightOffset)

                    local angle = wheelAngle + ((indexInWheel / 8) * math.pi * 2)
                    local offsetLook = math.cos(angle) * wheelRadius
                    local offsetUp = math.sin(angle) * wheelRadius

                    local blockPos = sideCenter + (hrp.CFrame.LookVector * offsetLook) + Vector3.new(0, offsetUp, 0)
                    wBlock.CFrame = CFrame.new(blockPos, blockPos + hrp.CFrame.LookVector)

                    local hue = ((i / 16) + (wheelAngle / (math.pi * 2))) % 1
                    local rainbowColor = Color3.fromHSV(hue, 1, 1)

                    wBlock.Color = rainbowColor
                    if wBlock:FindFirstChild("AuraLight") then wBlock.AuraLight.Color = rainbowColor end
                    if wBlock:FindFirstChild("AuraTrail") then wBlock.AuraTrail.Color = ColorSequence.new(rainbowColor) end
                end
            end
        else
            if dualWheelFolder then dualWheelFolder:Destroy() end
        end

    end
end)

