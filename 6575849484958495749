local function BroadcastAudioToServer(soundIdRaw)
    task.spawn(function()
        local foundRemote = nil
        if LocalPlayer.Character then
            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool then
                foundRemote = tool:FindFirstChildOfClass("RemoteEvent") or tool:FindFirstChild("RemoteFunction")
            end
        end
        if not foundRemote then
            for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                if v:IsA("RemoteEvent") and (v.Name:lower():find("boombox") or v.Name:lower():find("audio") or v.Name:lower():find("sound")) then
                    foundRemote = v
                    break
                end
            end
        end

        if foundRemote and foundRemote:IsA("RemoteEvent") then
            pcall(function()
                foundRemote:FireServer(soundIdRaw)
                foundRemote:FireServer("Play", soundIdRaw)
            end)
        end
    end)
end

