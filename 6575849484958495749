local function SpawnGoldenBoombox()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local oldBoombox = workspace:FindFirstChild("ZzzZ_GoldenBoombox_" .. LocalPlayer.Name)
    if oldBoombox then oldBoombox:Destroy() end

    local hrp = LocalPlayer.Character.HumanoidRootPart
    local spawnPos = hrp.Position + (hrp.CFrame.LookVector * 4)

    local boomboxModel = Instance.new("Model")
    boomboxModel.Name = "ZzzZ_GoldenBoombox_" .. LocalPlayer.Name

    local mainBody = Instance.new("Part")
    mainBody.Name = "MainBody"
    mainBody.Size = Vector3.new(3, 1.8, 1.2)
    mainBody.CFrame = CFrame.new(spawnPos) * CFrame.Angles(0, math.rad(hrp.Orientation.Y), 0)
    mainBody.Color = Color3.fromRGB(255, 215, 0)
    mainBody.Material = Enum.Material.SmoothPlastic
    mainBody.Anchored = true
    mainBody.CanCollide = true
    mainBody.Parent = boomboxModel

    for _, side in ipairs({-1, 1}) do
        local speaker = Instance.new("Part")
        speaker.Size = Vector3.new(0.9, 0.9, 0.1)
        speaker.CFrame = mainBody.CFrame * CFrame.new(side * 0.9, 0, 0.56)
        speaker.Color = Color3.fromRGB(30, 30, 30)
        speaker.Material = Enum.Material.DiamondPlate
        speaker.Anchored = true
        speaker.CanCollide = false
        speaker.Parent = boomboxModel

        local light = Instance.new("PointLight")
        light.Name = "SpeakerLight"
        light.Color = Color3.fromRGB(255, 215, 0)
        light.Range = 8
        light.Brightness = 3
        light.Parent = speaker
    end

    local handle = Instance.new("Part")
    handle.Size = Vector3.new(2, 0.2, 0.2)
    handle.CFrame = mainBody.CFrame * CFrame.new(0, 1.1, 0)
    handle.Color = Color3.fromRGB(200, 160, 0)
    handle.Material = Enum.Material.Metal
    handle.Anchored = true
    handle.CanCollide = false
    handle.Parent = boomboxModel

    boomboxModel.Parent = workspace
    State.BoomboxSpawned = true
end

