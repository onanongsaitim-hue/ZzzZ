-- Functionality: Create & Manage Spinning Back Sword
local function buildSwordModel()
    local sword = Instance.new("Model")
    sword.Name = "ZzzZ_BackSword"

    -- Blade (ใบดาบ)
    local blade = Instance.new("Part")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.3, 4.5, 0.6)
    blade.Material = Enum.Material.Neon
    blade.Color = Color3.fromRGB(0, 220, 255)
    blade.CanCollide = false
    blade.Parent = sword

    -- Guard (กระบังดาบ)
    local guard = Instance.new("Part")
    guard.Name = "Guard"
    guard.Size = Vector3.new(0.5, 0.3, 1.4)
    guard.Material = Enum.Material.SmoothPlastic
    guard.Color = Color3.fromRGB(255, 215, 0)
    guard.CanCollide = false
    guard.Parent = sword

    local gWeld = Instance.new("Weld")
    gWeld.Part0 = blade
    gWeld.Part1 = guard
    gWeld.C0 = CFrame.new(0, -2.1, 0)
    gWeld.Parent = blade

    -- Handle (ด้ามจับ)
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.3, 1.2, 0.3)
    handle.Material = Enum.Material.SmoothPlastic
    handle.Color = Color3.fromRGB(40, 40, 40)
    handle.CanCollide = false
    handle.Parent = sword

    local hWeld = Instance.new("Weld")
    hWeld.Part0 = blade
    hWeld.Part1 = handle
    hWeld.C0 = CFrame.new(0, -2.8, 0)
    hWeld.Parent = blade

    sword.PrimaryPart = blade
    return sword, blade
end

local function applySpinningSword(char)
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    local existing = char:FindFirstChild("ZzzZ_BackSword")
    if spinningSwordEnabled then
        if not existing then
            local sword, blade = buildSwordModel()
            sword.Parent = char

            local motor = Instance.new("Motor6D")
            motor.Name = "SwordSpinMotor"
            motor.Part0 = torso
            motor.Part1 = blade
            motor.C0 = CFrame.new(0, 0.5, 1.2) -- วางไว้ด้านหลังตัวละคร
            motor.Parent = torso
        end
    else
        if existing then
            existing:Destroy()
        end
        local oldMotor = torso:FindFirstChild("SwordSpinMotor")
        if oldMotor then oldMotor:Destroy() end
    end
end

local function applyAura(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local existingAura = hrp:FindFirstChild("ZzzZAura")
    if auraEnabled then
        if not existingAura then
            local pe = Instance.new("ParticleEmitter")
            pe.Name = "ZzzZAura"
            pe.Texture = "rbxassetid://242202318"
            pe.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 85, 0))
            pe.Size = NumberSequence.new(3, 6)
            pe.Rate = 35
            pe.Lifetime = NumberRange.new(0.5, 1)
            pe.Speed = NumberRange.new(5, 10)
            pe.Parent = hrp
        end
    else
        if existingAura then
            existingAura:Destroy()
        end
    end
end

