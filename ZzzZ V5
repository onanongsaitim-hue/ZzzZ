-- Main Render Loop: Hitbox Updates & Smooth Sword Rotation
RunService.RenderStepped:Connect(function(deltaTime)
    -- 1. Smooth Rotate Sword
    if spinningSwordEnabled and LocalPlayer.Character then
        local torso = LocalPlayer.Character:FindFirstChild("UpperTorso") or LocalPlayer.Character:FindFirstChild("Torso")
        if torso then
            local motor = torso:FindFirstChild("SwordSpinMotor")
            if motor then
                swordRotationAngle = (swordRotationAngle + (180 * deltaTime)) % 360 -- หมุนความเร็วสมูท
                motor.C1 = CFrame.Angles(0, 0, math.rad(swordRotationAngle))
            end
        end
    end

    -- 2. Hitbox Expansion Loop
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")

            if head then
                if headHitboxEnabled then
                    head.Size = Vector3.new(headSize, headSize, headSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            if torso then
                if bodyHitboxEnabled then
                    torso.Size = Vector3.new(bodySize, bodySize, bodySize)
                    torso.Transparency = 0.5
                    torso.CanCollide = false
                else
                    torso.Size = Vector3.new(2, 2, 1)
                    torso.Transparency = 0
                end
            end
        end
    end
end)
