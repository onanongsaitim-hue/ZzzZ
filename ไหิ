-- 7. ฟังก์ชันย่อตัวละครและจัดการตำแหน่งตัวละคร
-- ==========================================
local function setCharacterMiniMode(char, enabled)
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if enabled then
		if root then
			originalCharCFrame = root.CFrame
			root.Anchored = true
		end
		if hum then
			originalScale = char:GetScale()
		end
		pcall(function()
			char:ScaleTo(0.15)
		end)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	else
		pcall(function()
			char:ScaleTo(originalScale or 1)
		end)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.CanCollide = true
			end
		end
		if root then
			root.Anchored = false
			if originalCharCFrame then
				root.CFrame = originalCharCFrame
			end
		end
	end
end

-- ==========================================
-- 8. ฟังก์ชันควบคุมการบินโดรน (ระบบสลับมุมมอง 1 และ 2)
-- ==========================================
local function startDroneControl()
	if not deployedDrone or not deployedDrone.PrimaryPart then return end
	
	local char = player.Character
	setCharacterMiniMode(char, true)

	playStaticFlashback(function()
		isControlling = true
		hackerGui.Enabled = true
		camera.CameraType = Enum.CameraType.Scriptable
	end)

	local dronePart = deployedDrone.PrimaryPart
	local currentPos = dronePart.Position
	local currentYaw = 0
	local currentPitch = 0
	local currentTiltPitch = 0 
	local currentTiltRoll = 0  

	local turnSpeed = 3.2
	local pitchSpeed = 2.5
	
	local charSpinAngle = 0
	local spinSpeedRad = math.rad(360) * 15

	if droneConnection then droneConnection:Disconnect() end

	local floorRayParams = RaycastParams.new()
	floorRayParams.FilterType = Enum.RaycastFilterType.Exclude
	floorRayParams.IgnoreWater = true

	droneConnection = RunService.RenderStepped:Connect(function(dt)
		if not deployedDrone or not deployedDrone.Parent then
			stopDroneControl()
			return
		end

		-- หมุนตัวละครจิ๋วปั่นอยู่ในโดรนตลอดเวลา
		charSpinAngle = (charSpinAngle + spinSpeedRad * dt) % (math.pi * 2)
		local currentChar = player.Character
		if currentChar and currentChar:FindFirstChild("HumanoidRootPart") then
			currentChar.HumanoidRootPart.CFrame = CFrame.new(currentPos) * CFrame.Angles(charSpinAngle, charSpinAngle * 1.5, charSpinAngle * 0.8)
		end

		if not isControlling then return end

		-- 1. ควบคุมการหมุนรอบตัวเอง 360 องศา
		if turnLeft then currentYaw = currentYaw + (turnSpeed * dt) end
		if turnRight then currentYaw = currentYaw - (turnSpeed * dt) end

		if math.abs(aimInputX) > 0.05 then
			currentYaw = currentYaw - (aimInputX * turnSpeed * dt * 2.0)
		end
		if math.abs(aimInputY) > 0.05 then
			currentPitch = math.clamp(currentPitch - (aimInputY * pitchSpeed * dt * 2.0), math.rad(-160), math.rad(160))
		end

		local lookRotCF = CFrame.Angles(0, currentYaw, 0) * CFrame.Angles(currentPitch, 0, 0)
		local aimForwardVec = lookRotCF.LookVector

		-- 2. เคลื่อนที่
		local moveVector = Vector3.new(0, 0, 0)
		if moveForward then moveVector = moveVector + aimForwardVec end
		if moveBackward then moveVector = moveVector - aimForwardVec end

		local intendedPos = currentPos + (moveVector * droneSpeed * dt)

		-- 3. ระบบล็อกความสูงไม่ให้ตกพื้น
		floorRayParams.FilterDescendantsInstances = {player.Character, deployedDrone}
		local floorRay = workspace:Raycast(intendedPos + Vector3.new(0, 5, 0), Vector3.new(0, -500, 0), floorRayParams)
		if floorRay then
			local minAllowedY = floorRay.Position.Y + 0.65
			if intendedPos.Y < minAllowedY then
				intendedPos = Vector3.new(intendedPos.X, minAllowedY, intendedPos.Z)
			end
		end

		currentPos = intendedPos

		-- 4. ระบบเอียงตัวโดรน
		local targetTiltPitch = 0
		if moveForward then targetTiltPitch = math.rad(-16)
		elseif moveBackward then targetTiltPitch = math.rad(16) end

		local targetTiltRoll = 0
		if turnLeft or aimInputX < -0.1 then targetTiltRoll = math.rad(22)
		elseif turnRight or aimInputX > 0.1 then targetTiltRoll = math.rad(-22) end

		currentTiltPitch = currentTiltPitch + (targetTiltPitch - currentTiltPitch) * math.clamp(dt * 12, 0, 1)
		currentTiltRoll = currentTiltRoll + (targetTiltRoll - currentTiltRoll) * math.clamp(dt * 12, 0, 1)

		local finalRotCF = CFrame.Angles(0, currentYaw, 0) 
			* CFrame.Angles(currentPitch + currentTiltPitch, 0, currentTiltRoll)

		local targetCF = CFrame.new(currentPos) * finalRotCF
		deployedDrone:SetPrimaryPartCFrame(targetCF)

		-- 5. จัดการมุมมองกล้องตามโหมดที่เลือก (1 หรือ 2)
		if cameraMode == 1 then
			-- มุมมองบุคคลที่ 1 (ติดอยู่ตรงกล้องโดรน)
			camera.CFrame = targetCF * CFrame.new(0, 0.4, 0)
		else
			-- มุมมองบุคคลที่ 2 (มองจากด้านหลัง เห็นตัวโดรนและตัวจิ๋วหมุนอยู่ข้างใน)
			camera.CFrame = targetCF * CFrame.new(0, 3.5, 7) * CFrame.Angles(math.rad(-20), 0, 0)
		end

		-- ภาพซ่าหน้าจอแฮ็กเกอร์แบบสุ่ม
		if math.random(1, 8) == 1 then
			staticOverlay.BackgroundColor3 = math.random(0, 1) == 0 and Color3.fromRGB(20, 220, 80) or Color3.fromRGB(5, 40, 15)
			staticOverlay.BackgroundTransparency = math.random(80, 95) / 100
		end
	end)
end

function stopDroneControl()
	if not isControlling and not droneConnection then return end
	isControlling = false
	hackerGui.Enabled = false

	if droneConnection then
		droneConnection:Disconnect()
		droneConnection = nil
	end

	setCharacterMiniMode(player.Character, false)

	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

