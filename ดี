		toggleBtn.Text = "ปิดใช้งานอุปกรณ์"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 80, 80)
		
		if player.Character then
			attachParts(player.Character)
			createBlockTool()
		end
	else
		toggleBtn.Text = "1. เปิดใช้งานอุปกรณ์"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
		
		stopControllingBlock()
		if waistPart then waistPart:Destroy() waistPart = nil end
		if backPart then backPart:Destroy() backPart = nil end
		if currentTool then currentTool:Destroy() currentTool = nil end
	end
end)

