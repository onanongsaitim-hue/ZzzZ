-- 2. ฟังก์ชันจัดการโมเดลบนตัวละคร
-- ==========================================
local function attachParts(character)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then return end

	if waistPart then waistPart:Destroy() end
	if backPart then backPart:Destroy() end

	-- ก้อนสี่เหลี่ยมสีดำที่ข้างเอว (ปรับตำแหน่ง X ให้มาอยู่ด้านข้าง)
	waistPart = Instance.new("Part")
	waistPart.Name = "WaistBlackBlock"
	waistPart.Size = Vector3.new(0.6, 0.6, 1.2)
	waistPart.Color = Color3.fromRGB(20, 20, 20)
	waistPart.Material = Enum.Material.SmoothPlastic
	waistPart.CanCollide = false
	waistPart.Massless = true
	waistPart.Parent = character

	local waistWeld = Instance.new("Weld")
	waistWeld.Part0 = torso
	waistWeld.Part1 = waistPart
	waistWeld.C0 = CFrame.new(1.1, -0.8, 0) -- ย้ายมาไว้ที่ข้างเอวด้านขวา
	waistWeld.Parent = waistPart

	-- ก้อนสี่เหลี่ยมยาวสีเทาที่หลัง
	backPart = Instance.new("Part")
	backPart.Name = "BackGreyBlock"
	backPart.Size = Vector3.new(0.8, 3.2, 0.4)
	backPart.Color = Color3.fromRGB(130, 130, 135)
	backPart.Material = Enum.Material.Metal
	backPart.CanCollide = false
	backPart.Massless = true
	backPart.Parent = character

	local backWeld = Instance.new("Weld")
	backWeld.Part0 = torso
	backWeld.Part1 = backPart
	backWeld.C0 = CFrame.new(0, 0.2, 0.7) * CFrame.Angles(0, 0, math.rad(15))
	backWeld.Parent = backPart
end

-- ==========================================
-- 3. ฟังก์ชันหยุดการบินและคืนค่ามุมมอง
-- ==========================================
local function stopControllingBlock()
	isFlying = false
	recallBtn.Visible = false
	
	if flightConnection then
		flightConnection:Disconnect()
		flightConnection = nil
	end
	
	if activeProjectile then
		activeProjectile:Destroy()
		activeProjectile = nil
	end

	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		
		if humanoid then
			camera.CameraSubject = humanoid
			camera.CameraType = Enum.CameraType.Custom
		end
		
		if rootPart then
			rootPart.Anchored = false
		end
		
		if currentTool and currentTool.Parent == character then
			local handle = currentTool:FindFirstChild("Handle")
			if handle then handle.Transparency = 0 end
		elseif backPart and not isFlying then
			backPart.Transparency = 0
		end
	end
end

-- ==========================================
-- 4. ฟังก์ชันยิงและบังคับบล็อกกลางอากาศ
-- ==========================================
local function launchBlock(targetPosition)
	if isFlying then return end
	local character = player.Character
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local handle = currentTool and currentTool:FindFirstChild("Handle")
	if not humanoid or not rootPart or not handle then return end

	isFlying = true
	recallBtn.Visible = true
	handle.Transparency = 1

	rootPart.Anchored = true

	activeProjectile = Instance.new("Part")
	activeProjectile.Name = "FlyingGreyBlock"
	activeProjectile.Size = Vector3.new(0.8, 0.4, 3.2)
	activeProjectile.Color = Color3.fromRGB(130, 130, 135)
	activeProjectile.Material = Enum.Material.Metal
	activeProjectile.CanCollide = true
	activeProjectile.Anchored = true
	activeProjectile.CFrame = CFrame.lookAt(handle.Position, targetPosition)
	activeProjectile.Parent = workspace

	camera.CameraSubject = activeProjectile

	local forwardSpeed = 45
	local steerSpeed = 35

	flightConnection = RunService.RenderStepped:Connect(function(dt)
		if not activeProjectile or not activeProjectile.Parent then
			stopControllingBlock()
			return
		end

		local moveDir = humanoid.MoveDirection
		local camLook = camera.CFrame.LookVector
		local currentPos = activeProjectile.Position
		
		local targetCFrame = CFrame.lookAt(currentPos, currentPos + camLook)
		local velocity = camLook * forwardSpeed
		
		if moveDir.Magnitude > 0 then
			local relativeMove = camera.CFrame:VectorToObjectSpace(moveDir)
			local rightVec = camera.CFrame.RightVector * (relativeMove.X * steerSpeed)
			local upVec = camera.CFrame.UpVector * (-relativeMove.Z * steerSpeed)
			velocity = velocity + rightVec + upVec
		end

		activeProjectile.CFrame = targetCFrame + (velocity * dt)
	end)
end

-- ==========================================
-- 5. สร้าง Tool (สิ่งของในตัวละคร)
-- ==========================================
local function createBlockTool()
	if currentTool then currentTool:Destroy() end

	local tool = Instance.new("Tool")
	tool.Name = "Remote Block"
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.8, 3.2, 0.4)
	handle.Color = Color3.fromRGB(130, 130, 135)
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Parent = tool

	tool.GripPos = Vector3.new(0, -0.5, 0)
	tool.GripForward = Vector3.new(0, 0, -1)
	tool.GripRight = Vector3.new(1, 0, 0)
	tool.GripUp = Vector3.new(0, 1, 0)

	tool.Equipped:Connect(function()
		if backPart then
			backPart.Transparency = 1
		end
		if not isFlying then
			handle.Transparency = 0
		end
	end)

	tool.Unequipped:Connect(function()
		if backPart and not isFlying then
			backPart.Transparency = 0
		end
	end)

	tool.Activated:Connect(function()
		if not isFlying then
			local targetPos = mouse.Hit.Position
			launchBlock(targetPos)
		end
	end)

	tool.Parent = player:WaitForChild("Backpack")
	currentTool = tool
end

