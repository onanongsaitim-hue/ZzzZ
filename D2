-- ระบบ Drag & Drop (ลากปุ่มวงกลมย้ายตำแหน่งได้)
local dragging = false
local dragStartPos = nil
local frameStartPos = nil
local totalDragDistance = 0

circleBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStartPos = input.Position
		frameStartPos = circleBtn.Position
		totalDragDistance = 0
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStartPos
		totalDragDistance = delta.Magnitude
		circleBtn.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	end
end)

-- การสลับการแสดงผล UI
closeButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
	circleBtn.Visible = true
end)

circleBtn.MouseButton1Click:Connect(function()
	if totalDragDistance < 5 then -- ถ้าขยับไม่ถึง 5 พิกเซล ถือว่าเป็นการคลิก ไม่ใช่การลาก
		circleBtn.Visible = false
		mainFrame.Visible = true
	end
end)


---------------------------------------------------------
-- PART 2: ระบบสกิลวาร์ป (วางลูกกลมสีขาว -> วาร์ป)
---------------------------------------------------------
local SKILL_KEY = Enum.KeyCode.E -- ปุ่มคีย์บอร์ดที่ใช้กดสกิล (ปุ่ม E)
local markPart = nil -- ตัวแปรเก็บลูกกลมสีขาว

local function triggerWarpSkill()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- กดครั้งที่ 1: ถ้ายังไม่มีลูกกลม ให้สร้างลูกกลมสีขาวขึ้นมา
	if markPart == nil then
		markPart = Instance.new("Part")
		markPart.Name = "TeleportMarkPart"
		markPart.Shape = Enum.PartType.Ball
		markPart.Size = Vector3.new(3.5, 3.5, 3.5)
		markPart.Color = Color3.fromRGB(255, 255, 255) -- สีขาว
		markPart.Material = Enum.Material.Neon -- เอฟเฟกต์เรืองแสง
		markPart.Anchored = true
		markPart.CanCollide = false
		
		-- วางลูกกลมไว้ด้านหน้าตัวละคร 5 หน่วย
		markPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -5)
		markPart.Parent = workspace

	-- กดครั้งที่ 2: ถ้ามีลูกกลมอยู่แล้ว ให้วาร์ปไปหาลูกกลม
	else
		-- วาร์ปตัวละครไปจุดที่มีลูกกลม (ยกสูงขึ้นเล็กน้อยเพื่อกันจมพื้น)
		hrp.CFrame = markPart.CFrame + Vector3.new(0, 2, 0)
		
		-- ลบลูกกลมออกและคืนค่าตัวแปร
		markPart:Destroy()
		markPart = nil
	end
end

-- กดปุ่มสกิลผ่านปุ่มบน UI
useSkillBtn.MouseButton1Click:Connect(triggerWarpSkill)

-- กดปุ่มสกิลผ่านคีย์บอร์ด (ปุ่ม E)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end -- ถ้าพิมพ์ช่องแชทอยู่จะไม่ทำงาน
	if input.KeyCode == SKILL_KEY then
		triggerWarpSkill()
	end
end)
