-- ⚔️ SKILL 1 ACTION (ถอดดาบมาฟัน + ส่งกระเด็น)
-- ========================================================
skill1Btn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    if not char then return end

    local rightArm = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local folder = char:FindFirstChild("ZzzZ_10Swords")
    if not folder or not rightArm or not torso then return end

    isPerformingSpecial = true

    local sword1 = folder:FindFirstChild("AwesomeSword_1")
    local motor1 = torso:FindFirstChild("SwordMotor_1")
    if sword1 and motor1 then
        motor1.Part0 = rightArm
        motor1.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), 0, 0)

        local rShoulder = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder")
        local origC0 = rShoulder and rShoulder.C0 or CFrame.new()

        if rShoulder then
            TweenService:Create(rShoulder, TweenInfo.new(0.2), {C0 = origC0 * CFrame.Angles(math.rad(120), 0, math.rad(30))}):Play()
            task.wait(0.25)

            TweenService:Create(rShoulder, TweenInfo.new(0.12), {C0 = origC0 * CFrame.Angles(math.rad(-50), math.rad(-60), math.rad(-20))}):Play()
            
            -- สร้างคลื่นพลังดาบพุ่งไปข้างหน้า
            local wave = Instance.new("Part")
            wave.Size = Vector3.new(6, 0.2, 6)
            wave.Material = Enum.Material.Neon
            wave.Color = Color3.fromRGB(0, 230, 255)
            wave.CFrame = torso.CFrame * CFrame.new(0, 0, -4) * CFrame.Angles(0, 0, math.rad(45))
            wave.CanCollide = false
            wave.Parent = workspace
            
            -- ตรวจจับผู้เล่นที่โดนคลื่นดาบ
            wave.Touched:Connect(function(hit)
                local hitModel = hit.Parent
                if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
                    sendToSpace(hitModel)
                end
            end)

            TweenService:Create(wave, TweenInfo.new(0.35), {Size = Vector3.new(15, 0.1, 15), Transparency = 1, CFrame = wave.CFrame * CFrame.new(0, 0, -35)}):Play()
            game:GetService("Debris"):AddItem(wave, 0.4)

            task.wait(0.3)
            TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0}):Play()
        end

        motor1.Part0 = torso
    end

    isPerformingSpecial = false
end)

-- ========================================================
-- 🌀 SKILL 2 ACTION (ชูมือขึ้นฟ้า -> กงจักรหมุนพุ่งส่งออกนอกโลก -> หมุนกลับหลัง)
-- ========================================================
skill2Btn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial then return end
    local char = LocalPlayer.Character
    if not char then return end

    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local rightArm = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local folder = char:FindFirstChild("ZzzZ_10Swords")
    if not folder or not torso or not rightArm then return end

    isPerformingSpecial = true

    local rShoulder = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder")
    local origC0 = rShoulder and rShoulder.C0 or CFrame.new()

    -- 1. ชูมือขึ้นฟ้า + วงจักรขึ้นเหนือหัว
    if rShoulder then
        TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0 * CFrame.Angles(math.rad(165), 0, 0)}):Play()
    end

    for i = 1, 10 do
        local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
        if motor then
            TweenService:Create(motor, TweenInfo.new(0.3), {
                C0 = CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(90), 0, math.rad(i * 36))
            }):Play()
        end
    end
    task.wait(0.4)

    -- 2. ชี้ไปข้างหน้า + กงจักรพุ่ง
    if rShoulder then
        TweenService:Create(rShoulder, TweenInfo.new(0.15), {C0 = origC0 * CFrame.Angles(math.rad(90), 0, 0)}):Play()
    end

    swordSpinSpeed = 2000
    local targetDist = 55

    -- ตรวจจับผู้เล่นในเส้นทางพุ่งของกงจักร
    local regionCenter = torso.CFrame * CFrame.new(0, 0, -targetDist/2)
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
            local oChar = otherPlayer.Character
            local oHrP = oChar:FindFirstChild("HumanoidRootPart")
            if oHrP and (oHrP.Position - regionCenter.Position).Magnitude <= 25 then
                sendToSpace(oChar)
            end
        end
    end

    for i = 1, 10 do
        local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
        if motor then
            TweenService:Create(motor, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                C0 = CFrame.new(0, 1, -targetDist) * CFrame.Angles(math.rad(90), 0, math.rad(i * 36))
            }):Play()
        end
    end
    task.wait(0.6)

    -- 3. หมุนโค้งกลับหลัง
    for i = 1, 10 do
        local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
        if motor then
            TweenService:Create(motor, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                C0 = CFrame.new(0, 0, 1.5) * CFrame.Angles(0, 0, math.rad(i * 36))
            }):Play()
        end
    end
    task.wait(0.5)

    swordSpinSpeed = 120
    if rShoulder then
        TweenService:Create(rShoulder, TweenInfo.new(0.3), {C0 = origC0}):Play()
    end

    isPerformingSpecial = false
end)

-- Main Render Loop (Idle & Walk Animation)
RunService.RenderStepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    if char and swordRingEnabled and not isPerformingSpecial then
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local rightArm = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
        local leftArm = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")

        -- ท่าเอามือกุมหลัง
        if torso and rightArm and leftArm then
            local rShoulder = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("Right Shoulder")
            local lShoulder = leftArm:FindFirstChild("LeftShoulder") or torso:FindFirstChild("Left Shoulder")

            if rShoulder and lShoulder then
                rShoulder.C0 = rShoulder.C0:Lerp(CFrame.new(1, 0, 0.5) * CFrame.Angles(math.rad(-45), math.rad(-20), math.rad(-15)), 0.2)
                lShoulder.C0 = lShoulder.C0:Lerp(CFrame.new(-1, 0, 0.5) * CFrame.Angles(math.rad(-45), math.rad(20), math.rad(15)), 0.2)
            end
        end

        -- วงแหวนดาบหมุน
        if torso then
            swordAngle = (swordAngle + (swordSpinSpeed * deltaTime)) % 360

            for i = 1, 10 do
                local motor = torso:FindFirstChild("SwordMotor_" .. tostring(i))
                if motor then
                    local offsetRad = math.rad(swordAngle + (i * 36))
                    local x = math.cos(offsetRad) * swordRingRadius
                    local y = math.sin(offsetRad) * swordRingRadius

                    motor.C0 = CFrame.new(x, y, 1.2) * CFrame.Angles(0, 0, offsetRad - math.rad(90))
                end
            end
        end
    end
end)
