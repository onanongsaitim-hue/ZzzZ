local function createSingleAwesomeSword(index)
    local sword = Instance.new("Model")
    sword.Name = "AwesomeSword_" .. tostring(index)

    local blade = Instance.new("Part")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.2, 4.2, 0.5)
    blade.Material = Enum.Material.Neon
    blade.Color = Color3.fromHSV((index/10), 0.9, 1)
    blade.CanCollide = false
    blade.Parent = sword

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.25, 1.2, 0.25)
    handle.Material = Enum.Material.SmoothPlastic
    handle.Color = Color3.fromRGB(30, 30, 30)
    handle.CanCollide = false
    handle.Parent = sword

    local hWeld = Instance.new("Weld")
    hWeld.Part0 = blade
    hWeld.Part1 = handle
    hWeld.C0 = CFrame.new(0, -2.4, 0)
    hWeld.Parent = blade

    sword.PrimaryPart = blade
    return sword
end

local function spawn10Swords(char)
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    local existingFolder = char:FindFirstChild("ZzzZ_10Swords")
    if swordRingEnabled then
        if not existingFolder then
            local folder = Instance.new("Folder")
            folder.Name = "ZzzZ_10Swords"
            folder.Parent = char

            for i = 1, 10 do
                local sw = createSingleAwesomeSword(i)
                sw.Parent = folder

                local motor = Instance.new("Motor6D")
                motor.Name = "SwordMotor_" .. tostring(i)
                motor.Part0 = torso
                motor.Part1 = sw.PrimaryPart
                motor.Parent = torso
            end
        end
        skillContainer.Visible = true
    else
        if existingFolder then existingFolder:Destroy() end
        skillContainer.Visible = false
    end
end

