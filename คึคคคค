screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local recallBtn = Instance.new("TextButton")
recallBtn.Size = UDim2.new(0, 140, 0, 50)
recallBtn.Position = UDim2.new(0.5, -70, 0.82, 0)
recallBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
recallBtn.Text = "🔄 เรียกเครื่องบินกลับ"
recallBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
recallBtn.Font = Enum.Font.GothamBold
recallBtn.TextSize = 14
