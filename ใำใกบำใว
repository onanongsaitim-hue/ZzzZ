-- ระบบลากหน้าต่าง UI
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- 2. ระบบหน้าจอสีเทา, กระดูกสันหลังสีดำ และร่างเงาสายรุ้ง 20 ตัว
local ColorEffect = Instance.new("ColorCorrectionEffect")
ColorEffect.Name = "GrayScreenEffect"
ColorEffect.Saturation = -1
ColorEffect.Enabled = false
ColorEffect.Parent = Lighting

local CloneFolder = Instance.new("Folder")
CloneFolder.Name = "RainbowAfterimages"
CloneFolder.Parent = workspace

local spineModel = nil

local function createSpine(char)
	if spineModel then spineModel:Destroy() end
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not torso then return end

	spineModel = Instance.new("Model")
	spineModel.Name = "BlackSpine"

	for i = -2, 2 do
		local bone = Instance.new("Part")
		bone.Size = Vector3.new(0.35, 0.25, 0.25)
		bone.Color = Color3.fromRGB(0, 0, 0)
		bone.Material = Enum.Material.SmoothPlastic
		bone.CanCollide = false
		bone.Massless = true
		bone.CFrame = torso.CFrame * CFrame.new(0, i * 0.3, 0.6)
		bone.Parent = spineModel

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = bone
		weld.Parent = bone
	end

	spineModel.Parent = char
end

local function removeSpine()
	if spineModel then
		spineModel:Destroy()
		spineModel = nil
	end
end

-- ลำดับสีเริ่มจากเขียวและไล่เป็นสายรุ้ง
local RainbowColors = {
	Color3.fromRGB(0, 255, 0),     -- 1. เขียว
	Color3.fromRGB(0, 255, 255),   -- 2. ฟ้า
	Color3.fromRGB(0, 100, 255),   -- 3. น้ำเงิน
	Color3.fromRGB(180, 0, 255),   -- 4. ม่วง
	Color3.fromRGB(255, 0, 120),   -- 5. ชมพู/แดง
	Color3.fromRGB(255, 128, 0),   -- 6. ส้ม
	Color3.fromRGB(255, 255, 0)    -- 7. เหลือง
}

local isEnabled = false
local colorIndex = 1
local activeClones = {}
local spawnTimer = 0
local spawnInterval = 0.04 -- ความเร็วในการออกทีละตัว (ปรับให้สมูทขึ้นสำหรับ 20 ตัว)
local maxClones = 20         -- จำนวนร่างเงาสูงสุด 20 ตัว

local function createAfterimage(char)
	-- ถ้าเกิน 20 ตัว ให้เอาตัวที่เก่าที่สุดออกทีละตัวแบบเรียงลำดับ
	if #activeClones >= maxClones then
		local oldestClone = table.remove(activeClones, 1)
		if oldestClone and oldestClone.Parent then
			oldestClone:Destroy()
		end
	end

	local cloneModel = Instance.new("Model")
	cloneModel.Name = "Afterimage"
	
	local currentColor = RainbowColors[colorIndex]
	colorIndex = (colorIndex % #RainbowColors) + 1

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local clonedPart = Instance.new("Part")
			clonedPart.Size = part.Size
			clonedPart.CFrame = part.CFrame
			clonedPart.Anchored = true
			clonedPart.CanCollide = false
			clonedPart.Material = Enum.Material.Neon
			clonedPart.Color = currentColor
			clonedPart.Transparency = 0.4
			clonedPart.Parent = cloneModel
		end
	end

	cloneModel.Parent = CloneFolder
	table.insert(activeClones, cloneModel)
end

local function clearAllClones()
	for _, clone in ipairs(activeClones) do
		if clone and clone.Parent then
			clone:Destroy()
		end
	end
	table.clear(activeClones)
	colorIndex = 1
end

-- อัปเดตการทำงานทุกเฟรม
local loopConnection
loopConnection = RunService.Heartbeat:Connect(function(dt)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	
	if isEnabled and char and hum then
		hum.WalkSpeed = 300
		ColorEffect.Enabled = true
		
		if hum.MoveDirection.Magnitude > 0 then
			spawnTimer = spawnTimer + dt
			if spawnTimer >= spawnInterval then
				spawnTimer = 0
				createAfterimage(char)
			end
		end
	end
end)

-- ปุ่มกดเปิด/ปิด
ToggleBtn.MouseButton1Click:Connect(function()
	isEnabled = not isEnabled
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	
	if isEnabled then
		ToggleBtn.Text = "ความเร็ว : เปิด"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 90)
		ColorEffect.Enabled = true
		if char then
			createSpine(char)
		end
	else
		ToggleBtn.Text = "ความเร็ว : ปิด"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
		ColorEffect.Enabled = false
		clearAllClones()
		removeSpine()
		if hum then
			hum.WalkSpeed = 16
		end
	end
end)

-- ปุ่มปิด UI และล้างค่าทั้งหมด
CloseBtn.MouseButton1Click:Connect(function()
	isEnabled = false
	if loopConnection then
		loopConnection:Disconnect()
	end
	ColorEffect:Destroy()
	clearAllClones()
	removeSpine()
	CloneFolder:Destroy()
	
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = 16
	end
	
	ScreenGui:Destroy()
end)
