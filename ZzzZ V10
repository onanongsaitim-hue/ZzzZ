-- 🚀 ฟังก์ชันส่งผู้เล่นอื่นกระเด็นออกนอกโลก
-- --------------------------------------------------------
local function sendToSpace(targetChar)
    if not targetChar then return end
    local targetHrP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

    if targetHrP and targetHum then
        targetHum.PlatformStand = true
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVelocity.Velocity = Vector3.new(math.random(-500, 500), 500000, math.random(-500, 500))
        bodyVelocity.Parent = targetHrP
        game:GetService("Debris"):AddItem(bodyVelocity, 1.5)
    end
end

-- --------------------------------------------------------
-- 🔥 ฟังก์ชันสร้าง ออร่าไฟ (Fire Effect)
-- --------------------------------------------------------
local function attachFireAura(part)
    local fire = Instance.new("Fire")
    fire.Size = 8
    fire.Heat = 15
    fire.Color = Color3.fromRGB(255, 120, 0)
    fire.SecondaryColor = Color3.fromRGB(255, 230, 50)
    fire.Parent = part
    return fire
end

