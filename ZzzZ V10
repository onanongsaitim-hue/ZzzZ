-- ========================================================
-- 🔥 SKILL 1 COMBO ACTION (กดครั้งที่ 1, 2, 3 ดาบพุ่งฟันไฟ / กดครั้งที่ 4 พุ่งฟันพร้อมกันวิ้ง!)
-- ========================================================
skill1Btn.MouseButton1Click:Connect(function()
    if not swordRingEnabled or isPerformingSpecial or #dragonSwordsTable < 10 then return end
    local char = LocalPlayer.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    if not torso then return end

    isPerformingSpecial = true

    -- รีเซ็ตคอมโบหากไม่ได้กดนานเกิน 2.5 วินาที
    if tick() - lastSkill1Time > 2.5 then
        skill1Combo = 0
    end
    
    skill1Combo = (skill1Combo % 4) + 1
    lastSkill1Time = tick()

    local forwardCF = torso.CFrame

    if skill1Combo == 1 then
        -- 🔥 กดครั้งที่ 1: ดาบ 1 เล่มพุ่งฟันพร้อมออร่าไฟ
        local sw = dragonSwordsTable[1]
        local blade = sw and sw.PrimaryPart
        if blade then
            local fire = attachFireAura(blade)
            local slashCF = forwardCF * CFrame.new(-3, 2, -15) * CFrame.Angles(0, 0, math.rad(-45))
            
            TweenService:Create(blade, TweenInfo.new(0.12), {CFrame = slashCF}):Play()
            task.wait(0.12)

            local endCF = forwardCF * CFrame.new(8, 0, -25) * CFrame.Angles(0, 0, math.rad(60))
            
            local touchConn = blade.Touched:Connect(function(hit)
                local hitModel = hit.Parent
                if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
                    sendToSpace(hitModel)
                end
            end)

            TweenService:Create(blade, TweenInfo.new(0.18, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {CFrame = endCF}):Play()
            task.wait(0.2)

            if touchConn then touchConn:Disconnect() end
            if fire then fire:Destroy() end
        end

    elseif skill1Combo == 2 then
        -- 🔥 กดครั้งที่ 2: ดาบอีกเล่มพุ่งฟันสลับด้านพร้อมออร่าไฟ
        local sw = dragonSwordsTable[2]
        local blade = sw and sw.PrimaryPart
        if blade then
            local fire = attachFireAura(blade)
            local slashCF = forwardCF * CFrame.new(4, 3, -15) * CFrame.Angles(0, 0, math.rad(50))
            
            TweenService:Create(blade, TweenInfo.new(0.12), {CFrame = slashCF}):Play()
            task.wait(0.12)

            local endCF = forwardCF * CFrame.new(-8, -1, -25) * CFrame.Angles(0, 0, math.rad(-50))
            
            local touchConn = blade.Touched:Connect(function(hit)
                local hitModel = hit.Parent
                if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
                    sendToSpace(hitModel)
                end
            end)

            TweenService:Create(blade, TweenInfo.new(0.18, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {CFrame = endCF}):Play()
            task.wait(0.2)

            if touchConn then touchConn:Disconnect() end
            if fire then fire:Destroy() end
        end

    elseif skill1Combo == 3 then
        -- 🔥 กดครั้งที่ 3: ดาบเล่มที่สามพุ่งเสยจากล่างขึ้นบน
        local sw = dragonSwordsTable[3]
        local blade = sw and sw.PrimaryPart
        if blade then
            local fire = attachFireAura(blade)
            local slashCF = forwardCF * CFrame.new(0, -5, -15) * CFrame.Angles(math.rad(80), 0, 0)
            
            TweenService:Create(blade, TweenInfo.new(0.12), {CFrame = slashCF}):Play()
            task.wait(0.12)

            local endCF = forwardCF * CFrame.new(0, 12, -25) * CFrame.Angles(math.rad(-30), 0, 0)
            
            local touchConn = blade.Touched:Connect(function(hit)
                local hitModel = hit.Parent
                if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
                    sendToSpace(hitModel)
                end
            end)

            TweenService:Create(blade, TweenInfo.new(0.18, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {CFrame = endCF}):Play()
            task.wait(0.2)

            if touchConn then touchConn:Disconnect() end
            if fire then fire:Destroy() end
        end

    elseif skill1Combo == 4 then
        -- 💥 กดครั้งที่ 4: ดาบทั้งหมดที่เหลือพุ่งฟันพร้อมกันวิ้งระเบิดไฟ!
        local activeFires = {}
        local touchConns = {}

        -- เอฟเฟกต์แฟลชประกายแสงวิ้ง
        local flash = Instance.new("SelectionBox")
        flash.Color3 = Color3.fromRGB(255, 230, 100)
        flash.Adornee = torso
        flash.Parent = torso
        game:GetService("Debris"):AddItem(flash, 0.4)

        for i = 1, 10 do
            local sw = dragonSwordsTable[i]
            local blade = sw and sw.PrimaryPart
            if blade then
                table.insert(activeFires, attachFireAura(blade))
                
                -- ตั้งตำแหน่งกระจายล้อมเป้าหมาย
                local angle = (i * 36)
                local aimCF = forwardCF * CFrame.new(math.cos(math.rad(angle)) * 12, math.sin(math.rad(angle)) * 6, -20)
                blade.CFrame = CFrame.lookAt(aimCF.Position, forwardCF * CFrame.new(0, 0, -20).Position)
            end
        end

        task.wait(0.15)

        -- พุ่งสับเข้าหากลางเป้าหมายพร้อมกันทุกเล่ม!
        for i = 1, 10 do
            local sw = dragonSwordsTable[i]
            local blade = sw and sw.PrimaryPart
            if blade then
                local crossCF = forwardCF * CFrame.new(0, 0, -20) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), 0)
                
                local conn = blade.Touched:Connect(function(hit)
                    local hitModel = hit.Parent
                    if hitModel and hitModel:FindFirstChildOfClass("Humanoid") and hitModel ~= char then
                        sendToSpace(hitModel)
                    end
                end)
                table.insert(touchConns, conn)

                TweenService:Create(blade, TweenInfo.new(0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {CFrame = crossCF}):Play()
            end
        end

        task.wait(0.4)

        for _, conn in ipairs(touchConns) do conn:Disconnect() end
        for _, f in ipairs(activeFires) do if f then f:Destroy() end end
        
        skill1Combo = 0 -- รีเซ็ตคอมโบหลังจบสเต็ป 4
    end

    task.wait(0.1)
    isPerformingSpecial = false
end)

