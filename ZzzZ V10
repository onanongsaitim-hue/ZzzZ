local function createHolyWhiteGoldSword()
    local sword = Instance.new("Model")

    local blade = Instance.new("Part")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.8, 14, 2.5)
    blade.Material = Enum.Material.Neon
    blade.Color = Color3.fromRGB(255, 255, 245)
    blade.CanCollide = false
    blade.Anchored = true
    blade.Parent = sword

    local goldEdge = Instance.new("Part")
    goldEdge.Size = Vector3.new(1.0, 13.5, 0.6)
    goldEdge.Material = Enum.Material.SmoothPlastic
    goldEdge.Color = Color3.fromRGB(255, 205, 50)
    goldEdge.CanCollide = false
    goldEdge.Anchored = true
    goldEdge.Parent = sword

    local gWeld = Instance.new("WeldConstraint")
    gWeld.Part0 = blade
    gWeld.Part1 = goldEdge
    goldEdge.CFrame = blade.CFrame
    gWeld.Parent = blade

    local crossGuard = Instance.new("Part")
    crossGuard.Size = Vector3.new(1.2, 1.2, 5.0)
    crossGuard.Material = Enum.Material.SmoothPlastic
    crossGuard.Color = Color3.fromRGB(255, 215, 0)
    crossGuard.CanCollide = false
    crossGuard.Anchored = true
    crossGuard.Parent = sword

    local cWeld = Instance.new("WeldConstraint")
    cWeld.Part0 = blade
    cWeld.Part1 = crossGuard
    crossGuard.CFrame = blade.CFrame * CFrame.new(0, -6.5, 0)
    cWeld.Parent = blade

    sword.PrimaryPart = blade
    return sword
end

