-- RENDER LOOP
---------------------------------------------------------
local timer = 0

RunService.RenderStepped:Connect(function()
    timer = timer + 0.05

    -- Noclip
    if State.NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- Hitbox Adjustment
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                if State.HeadHitboxEnabled then
                    head.Size = Vector3.new(State.HeadSize, State.HeadSize, State.HeadSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            if plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if State.BodyHitboxEnabled then
                    hrp.Size = Vector3.new(State.BodySize, State.BodySize, State.BodySize)
                    hrp.Transparency = 0.6
                    hrp.Color = Color3.fromRGB(255, 0, 0)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end

    -- WalkSpeed
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if State.SpeedHackEnabled then
            hum.WalkSpeed = State.WalkSpeedValue
        end
    end

    -- Lighting
    if State.FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    Lighting.ClockTime = State.TimeOfDay

    -- Visual Effects Processing
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart
        local head = char:FindFirstChild("Head")

        -----------------------------------------------------
        -- 1. ปีกนางฟ้าเรืองแสงสีรุ้ง (ขยับพือปีกกาง-หุบ)
        -----------------------------------------------------
        local wingsFolder = workspace:FindFirstChild("ZzzZ_AngelWings_" .. LocalPlayer.Name)

        if State.RainbowWingsEnabled then
            if not wingsFolder then
                wingsFolder = Instance.new("Folder")
                wingsFolder.Name = "ZzzZ_AngelWings_" .. LocalPlayer.Name
                wingsFolder.Parent = workspace

                -- สร้างบล็อกขนปีกข้างละ 10 บล็อก (รวม 20 บล็อก)
                for i = 1, 20 do
                    local feather = Instance.new("Part")
                    feather.Name = "Feather_" .. i
                    feather.Size = Vector3.new(0.2, 0.8, 0.3)
                    feather.Material = Enum.Material.Neon
                    feather.Anchored = true
                    feather.CanCollide = false
                    feather.CanTouch = false
                    feather.CanQuery = false
                    feather.Parent = wingsFolder

                    local wLight = Instance.new("PointLight")
                    wLight.Name = "WingLight"
                    wLight.Range = 5
                    wLight.Brightness = 3
                    wLight.Parent = feather

                    local att0 = Instance.new("Attachment", feather)
                    att0.Position = Vector3.new(0, 0.3, 0)
                    local att1 = Instance.new("Attachment", feather)
                    att1.Position = Vector3.new(0, -0.3, 0)

                    local trail = Instance.new("Trail")
                    trail.Name = "WingTrail"
                    trail.Attachment0 = att0
                    trail.Attachment1 = att1
                    trail.Lifetime = 0.3
                    trail.FaceCamera = true
                    trail.LightEmission = 1
                    trail.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.2),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    trail.Parent = feather
                end
            end

            -- คำนวณมุมการขยับพือปีก (Flapping Motion)
            local flapAngle = math.sin(timer * 3) * 0.45 
            local backPos = hrp.CFrame.Position - (hrp.CFrame.LookVector * 0.6) + Vector3.new(0, 0.5, 0)

            for i = 1, 20 do
                local feather = wingsFolder:FindFirstChild("Feather_" .. i)
                if feather then
                    local isRight = (i <= 10)
                    local idx = isRight and i or (i - 10)
                    local sideSign = isRight and 1 or -1

                    -- วางตำแหน่งโครงสร้างปีกนกทรงโค้ง
                    local curveX = (idx * 0.25) * sideSign
                    local curveY = math.sin(idx * 0.3) * 0.5
                    local curveZ = -math.cos(idx * 0.2) * 0.3

                    local baseCFrame = CFrame.new(backPos) * hrp.CFrame.Rotation
                    local wingRot = CFrame.Angles(0, (flapAngle * sideSign) + (math.rad(25) * sideSign), math.rad(-15 * sideSign))
                    local featherCFrame = baseCFrame * wingRot * CFrame.new(curveX, curveY, curveZ) * CFrame.Angles(0, 0, math.rad(idx * 8 * sideSign))

                    feather.CFrame = featherCFrame

                    local hue = ((i / 20) + (timer * 0.2)) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.9, 1)

                    feather.Color = rainbowColor
                    if feather:FindFirstChild("WingLight") then feather.WingLight.Color = rainbowColor end
                    if feather:FindFirstChild("WingTrail") then feather.WingTrail.Color = ColorSequence.new(rainbowColor) end
                end
            end
        else
            if wingsFolder then wingsFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 2. มงกุฎพระราชาหรูหรา (ลอยขยับหมุนรอบหัว)
        -----------------------------------------------------
        local crownFolder = workspace:FindFirstChild("ZzzZ_RotatingKingCrown_" .. LocalPlayer.Name)

        if State.RotatingCrownEnabled and head then
            if not crownFolder then
                crownFolder = Instance.new("Folder")
                crownFolder.Name = "ZzzZ_RotatingKingCrown_" .. LocalPlayer.Name
                crownFolder.Parent = workspace

                -- สร้างโครงสร้างมงกุฎทรงพระราชา (12 บล็อก)
                for i = 1, 12 do
                    local cPart = Instance.new("Part")
                    cPart.Name = "CrownNode_" .. i
                    cPart.Size = (i % 2 == 0) and Vector3.new(0.25, 0.5, 0.25) or Vector3.new(0.2, 0.25, 0.2)
                    cPart.Material = Enum.Material.Neon
                    cPart.Anchored = true
                    cPart.CanCollide = false
                    cPart.CanTouch = false
                    cPart.CanQuery = false
                    cPart.Parent = crownFolder

                    local cLight = Instance.new("PointLight")
                    cLight.Name = "CrownLight"
                    cLight.Range = 5
                    cLight.Brightness = 3
                    cLight.Parent = cPart
                end
            end

            -- มงกุฎหมุนวนรอบหัว 360 องศา
            local crownSpin = timer * 1.5
            local crownCenter = head.Position + Vector3.new(0, 1.25 + (math.sin(timer * 2) * 0.1), 0)
            local crownRadius = 0.95

            for i = 1, 12 do
                local cPart = crownFolder:FindFirstChild("CrownNode_" .. i)
                if cPart then
                    local angle = crownSpin + ((i / 12) * math.pi * 2)
                    local cx = math.cos(angle) * crownRadius
                    local cz = math.sin(angle) * crownRadius
                    local cy = (i % 2 == 0) and 0.25 or 0 -- ยอดสูงต่ำสลับกันทรงมงกุฎพระราชา

                    local partPos = crownCenter + Vector3.new(cx, cy, cz)
                    cPart.CFrame = CFrame.new(partPos, crownCenter + Vector3.new(0, cy, 0)) * CFrame.Angles(0, math.rad(90), 0)

                    local hue = ((i / 12) + (timer * 0.2)) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.95, 1)

                    cPart.Color = rainbowColor
                    if cPart:FindFirstChild("CrownLight") then cPart.CrownLight.Color = rainbowColor end
                end
            end
        else
            if crownFolder then crownFolder:Destroy() end
        end

    end
end)

