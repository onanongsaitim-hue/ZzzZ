local timer = 0

RunService.RenderStepped:Connect(function()
    timer = timer + 0.05

    -- Aimbot (ช่วยเล็งหัว)
    if State.AimbotEnabled then
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), State.AimbotSmoothness)
        end
    end

    -- Noclip
    if State.NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- Hitbox & ESP Processing
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            -- Hitbox Adjustments
            if plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                if State.HeadHitboxEnabled then
                    head.Size = Vector3.new(State.HeadSize, State.HeadSize, State.HeadSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(1.2, 1.2, 1.2)
                    head.Transparency = 0
                end
            end

            if plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if State.BodyHitboxEnabled then
                    hrp.Size = Vector3.new(State.BodySize, State.BodySize, State.BodySize)
                    hrp.Transparency = 0.6
                    hrp.Color = Color3.fromRGB(255, 0, 0)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end

            -- Highlight ESP
            local espHighlight = plr.Character:FindFirstChild("ZzzZ_ESP_Highlight")
            if State.ESP_Highlight then
                if not espHighlight then
                    espHighlight = Instance.new("Highlight")
                    espHighlight.Name = "ZzzZ_ESP_Highlight"
                    espHighlight.FillColor = Color3.fromRGB(255, 0, 80)
                    espHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    espHighlight.FillTransparency = 0.4
                    espHighlight.Parent = plr.Character
                end
            else
                if espHighlight then espHighlight:Destroy() end
            end
        end
    end

    -- WalkSpeed
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if State.SpeedHackEnabled then
            hum.WalkSpeed = State.WalkSpeedValue
        end
    end

    -- Lighting
    if State.FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
    end
    Lighting.ClockTime = State.TimeOfDay

    -- VISUAL EFFECTS PROCESSING
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = LocalPlayer.Character
        local hrp = char.HumanoidRootPart
        local head = char:FindFirstChild("Head")

        -----------------------------------------------------
        -- 1. ปีกนางฟ้าขนาดใหญ่พิเศษ (ขยับพือปีกนุ่มนวลสมจริง)
        -----------------------------------------------------
        local wingsFolder = workspace:FindFirstChild("ZzzZ_RealMegaWings_" .. LocalPlayer.Name)

        if State.RainbowWingsEnabled then
            if not wingsFolder then
                wingsFolder = Instance.new("Folder")
                wingsFolder.Name = "ZzzZ_RealMegaWings_" .. LocalPlayer.Name
                wingsFolder.Parent = workspace

                -- สร้างโครงปีก 36 บล็อก (ขยายใหญ่ขึ้น อลังการสมจริง)
                for i = 1, 36 do
                    local feather = Instance.new("Part")
                    feather.Name = "Feather_" .. i
                    feather.Size = Vector3.new(0.4, 1.8, 0.6)
                    feather.Material = Enum.Material.Neon
                    feather.Anchored = true
                    feather.CanCollide = false
                    feather.CanTouch = false
                    feather.CanQuery = false
                    feather.Parent = wingsFolder

                    local wLight = Instance.new("PointLight")
                    wLight.Name = "WingLight"
                    wLight.Range = 8
                    wLight.Brightness = 4
                    wLight.Parent = feather

                    local att0 = Instance.new("Attachment", feather)
                    att0.Position = Vector3.new(0, 0.7, 0)
                    local att1 = Instance.new("Attachment", feather)
                    att1.Position = Vector3.new(0, -0.7, 0)

                    local trail = Instance.new("Trail")
                    trail.Name = "WingTrail"
                    trail.Attachment0 = att0
                    trail.Attachment1 = att1
                    trail.Lifetime = 0.5
                    trail.FaceCamera = true
                    trail.LightEmission = 1
                    trail.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.1),
                        NumberSequenceKeypoint.new(1, 1)
                    })
                    trail.Parent = feather
                end
            end

            -- ปรับความเร็วขยับพือปีกให้ช้าลง นุ่มนวล สมจริง (Realistic Slow Flap)
            local flapAngle = math.sin(timer * 1.6) * 0.55 
            local backPos = hrp.CFrame.Position - (hrp.CFrame.LookVector * 0.9) + Vector3.new(0, 1, 0)

            for i = 1, 36 do
                local feather = wingsFolder:FindFirstChild("Feather_" .. i)
                if feather then
                    local isRight = (i <= 18)
                    local idx = isRight and i or (i - 18)
                    local sideSign = isRight and 1 or -1

                    -- วางแนวขนนกสยายกว้างทรงโค้งแบบปีกนกสมจริง
                    local curveX = (idx * 0.5) * sideSign
                    local curveY = math.sin(idx * 0.22) * 1.5
                    local curveZ = -math.cos(idx * 0.12) * 0.7

                    local baseCFrame = CFrame.new(backPos) * hrp.CFrame.Rotation
                    local wingRot = CFrame.Angles(0, (flapAngle * sideSign) + (math.rad(28) * sideSign), math.rad(-18 * sideSign))
                    local featherCFrame = baseCFrame * wingRot * CFrame.new(curveX, curveY, curveZ) * CFrame.Angles(0, 0, math.rad(idx * 5 * sideSign))

                    feather.CFrame = featherCFrame

                    local hue = ((i / 36) + (timer * 0.15)) % 1
                    local rainbowColor = Color3.fromHSV(hue, 0.95, 1)

                    feather.Color = rainbowColor
                    if feather:FindFirstChild("WingLight") then feather.WingLight.Color = rainbowColor end
                    if feather:FindFirstChild("WingTrail") then feather.WingTrail.Color = ColorSequence.new(rainbowColor) end
                end
            end
        else
            if wingsFolder then wingsFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 2. มงกุฎพระราชาทรงสมจริง (Ultra Detailed Crown)
        -----------------------------------------------------
        local crownFolder = workspace:FindFirstChild("ZzzZ_DetailedCrown_" .. LocalPlayer.Name)

        if State.RotatingCrownEnabled and head then
            if not crownFolder then
                crownFolder = Instance.new("Folder")
                crownFolder.Name = "ZzzZ_DetailedCrown_" .. LocalPlayer.Name
                crownFolder.Parent = workspace

                for i = 1, 24 do
                    local cPart = Instance.new("Part")
                    cPart.Name = "CrownNode_" .. i
                    
                    if i <= 16 then
                        cPart.Size = (i % 2 == 0) and Vector3.new(0.2, 0.7, 0.25) or Vector3.new(0.18, 0.35, 0.2)
                    else
                        cPart.Size = Vector3.new(0.25, 0.25, 0.25)
                    end

                    cPart.Material = Enum.Material.Neon
                    cPart.Anchored = true
                    cPart.CanCollide = false
                    cPart.CanTouch = false
                    cPart.CanQuery = false
                    cPart.Parent = crownFolder

                    local cLight = Instance.new("PointLight")
                    cLight.Name = "CrownLight"
                    cLight.Range = 6
                    cLight.Brightness = 3
                    cLight.Parent = cPart
                end
            end

            local crownSpin = timer * 1.5
            local crownCenter = head.Position + Vector3.new(0, 1.35 + (math.sin(timer * 2) * 0.1), 0)
            local crownRadius = 1.1

            for i = 1, 24 do
                local cPart = crownFolder:FindFirstChild("CrownNode_" .. i)
                if cPart then
                    if i <= 16 then
                        local angle = crownSpin + ((i / 16) * math.pi * 2)
                        local cx = math.cos(angle) * crownRadius
                        local cz = math.sin(angle) * crownRadius
                        local cy = (i % 2 == 0) and 0.35 or 0

                        local partPos = crownCenter + Vector3.new(cx, cy, cz)
                        cPart.CFrame = CFrame.new(partPos, crownCenter + Vector3.new(0, cy, 0)) * CFrame.Angles(0, math.rad(90), 0)
                    else
                        local idx = i - 16
                        local angle = crownSpin + ((idx / 8) * math.pi * 2)
                        local cx = math.cos(angle) * (crownRadius * 0.9)
                        local cz = math.sin(angle) * (crownRadius * 0.9)
                        local cy = 0.75

                        cPart.CFrame = CFrame.new(crownCenter + Vector3.new(cx, cy, cz))
                    end

                    local hue = ((i / 24) + (timer * 0.2)) % 1
                    local rainbowColor = Color3.fromHSV(hue, 1, 1)

                    cPart.Color = rainbowColor
                    if cPart:FindFirstChild("CrownLight") then cPart.CrownLight.Color = rainbowColor end
                end
            end
        else
            if crownFolder then crownFolder:Destroy() end
        end

        -----------------------------------------------------
        -- 3. ออร่าสีรุ้งรอบตัว (Body Aura Effect)
        -----------------------------------------------------
        local auraPart = workspace:FindFirstChild("ZzzZ_RainbowAura_" .. LocalPlayer.Name)

        if State.AuraEnabled then
            if not auraPart then
                auraPart = Instance.new("Part")
                auraPart.Name = "ZzzZ_RainbowAura_" .. LocalPlayer.Name
                auraPart.Shape = Enum.PartType.Ball
                auraPart.Size = Vector3.new(7, 7, 7)
                auraPart.Material = Enum.Material.ForceField
                auraPart.Transparency = 0.5
                auraPart.Anchored = true
                auraPart.CanCollide = false
                auraPart.CanTouch = false
                auraPart.CanQuery = false
                auraPart.Parent = workspace
            end

            auraPart.CFrame = hrp.CFrame
            local hue = (timer * 0.3) % 1
            auraPart.Color = Color3.fromHSV(hue, 1, 1)
        else
            if auraPart then auraPart:Destroy() end
        end

    end
end)

