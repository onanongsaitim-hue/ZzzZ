    if guaranteedLuckEnabled then
        resultDisplay.Text = "👑 [ระบบ 2 - การันตี] ได้รับ: 💎 เพชรจักรพรรดิ์ (Legendary)!"
        return
    end

    local items = {
        {name = "🪵 กิ่งไม้", weight = 80},
        {name = "🛡️ เกราะเหล็ก", weight = 18},
        {name = "💎 เพชรจักรพรรดิ์", weight = 2}
    }

    local totalWeight = 0
    for _, item in ipairs(items) do totalWeight = totalWeight + item.weight end

