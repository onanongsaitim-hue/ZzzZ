-- Attack Engine (1 Second)
local ATTACK_INTERVAL = 1.0
local lastAttackTime = 0

RunService.Stepped:Connect(function()
    if not fastAttackEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")

    if tool and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        if tick() - lastAttackTime >= ATTACK_INTERVAL then
            lastAttackTime = tick()
            tool:Activate()
        end
    end
end)

-- Hitbox Rendering Loop
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            if head then
                if headHitboxEnabled then
                    head.Size = Vector3.new(headHitboxSize, headHitboxSize, headHitboxSize)
                    head.Transparency = 0.6
                    head.Color = Color3.fromRGB(0, 170, 255)
                    head.Material = Enum.Material.Neon
                    head.CanCollide = false
                else
                    head.Size = Vector3.new(2, 1, 1)
                    head.Transparency = 0
                    head.Material = Enum.Material.Plastic
                end
            end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if bodyHitboxEnabled then
                    hrp.Size = Vector3.new(bodyHitboxSize, bodyHitboxSize, bodyHitboxSize)
                    hrp.Transparency = 0.7
                    hrp.Color = Color3.fromRGB(0, 255, 120)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                end
            end
        end
    end
end)

